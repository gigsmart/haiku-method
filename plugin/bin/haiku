    out4("```bash");
    out4(`cat .haiku/intents/${intentSlug}/state/<key>`);
    out4("```");
    out4("");
  }
  if (contextScope === "build" || contextScope === "full") {
    out4("### Bootstrap (MANDATORY)");
    out4("");
    out4("Your spawn prompt tells you which worktree and branch to use.");
    out4("After entering your unit worktree, load unit-scoped state:");
