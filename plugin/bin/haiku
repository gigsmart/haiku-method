// src/hooks/workflow-guard.ts
import { existsSync as existsSync19, readdirSync as readdirSync13 } from "node:fs";
import { join as join30 } from "node:path";
function findActiveIntent2() {
  const intentsDir = join30(process.cwd(), ".haiku", "intents");
  if (!existsSync19(intentsDir)) return null;
  const dirs = readdirSync13(intentsDir).filter(
    (d) => existsSync19(join30(intentsDir, d, "intent.md"))
  );
  return dirs.length === 1 ? join30(intentsDir, dirs[0]) : null;
}
async function workflowGuard(input, _pluginRoot2) {
  const toolName = input.tool_name;
  if (toolName !== "Write" && toolName !== "Edit") return;
  const intentDir3 = findActiveIntent2();
  if (!intentDir3) return;
  const toolInput = input.tool_input || {};
  const filePath = toolInput.file_path || "";
  if (filePath.includes("/.haiku/")) return;
  process.stdout.write(
    `\u26A0\uFE0F WORKFLOW GUARD: Editing ${filePath} \u2014 ensure this is within an active hat's scope.
`
  );
}
