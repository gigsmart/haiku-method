    if (existsSync11(stageFile)) {
      const raw = readFileSync10(stageFile, "utf8");
      const fm = readFrontmatter(stageFile);
      const { content } = (0, import_gray_matter4.default)(raw);
      return {
        description: fm.description || stage,
        body: content.trim()
      };
    }
  }
  return null;
}
function checkExternalApproval(url) {
  try {
    if (url.includes("github.com") && url.includes("/pull/")) {
      const output = execFileSync3(
        "gh",
        [
          "pr",
          "view",
          url,
          "--json",
          "state,reviewDecision",
          "-q",
          "[.state, .reviewDecision]"
        ],
        { encoding: "utf8", stdio: "pipe" }
      ).trim();
      const parsed = JSON.parse(output);
      const [state, reviewDecision] = parsed;
      return state === "MERGED" || reviewDecision === "APPROVED";
    }
    if (url.includes("gitlab") && url.includes("/merge_requests/")) {
      const output = execFileSync3(
        "glab",
        ["mr", "view", url, "--output", "json"],
        { encoding: "utf8", stdio: "pipe" }
      ).trim();
      const mr = JSON.parse(output);
      return mr.state === "merged" || mr.approved === true;
    }
    return false;
  } catch {
    return false;
  }
}
function validateStageOutputs(slug, stage, studio) {
  const pluginRoot = resolvePluginRoot();
  for (const base of [
    join18(process.cwd(), ".haiku", "studios"),
    join18(pluginRoot, "studios")
  ]) {
    const outputsDir = join18(base, studio, "stages", stage, "outputs");
    if (!existsSync11(outputsDir)) continue;
    const outputDefs = readdirSync6(outputsDir).filter((f) => f.endsWith(".md"));
    const missing = [];
    for (const f of outputDefs) {
      const raw = readFileSync10(join18(outputsDir, f), "utf8");
      const { data } = (0, import_gray_matter4.default)(raw);
      const required3 = data.required !== false;
      if (!required3) continue;
      const location = data.location || "";
      if (!location) continue;
      if (location.startsWith("(")) continue;
      const resolved = location.replace("{intent-slug}", slug);
      const absPath = join18(process.cwd(), resolved);
      if (resolved.endsWith("/")) {
        if (!existsSync11(absPath) || readdirSync6(absPath).filter((e) => e !== ".gitkeep").length === 0) {
          missing.push({ name: data.name || f, location: resolved });
        }
      } else {
        if (!existsSync11(absPath)) {
          missing.push({ name: data.name || f, location: resolved });
        }
      }
    }
    if (missing.length > 0) {
      return {
        action: "outputs_missing",
        intent: slug,
        stage,
        missing,
        message: `Cannot advance to review: ${missing.length} required output(s) not found.
${missing.map((m2) => `- ${m2.name}: expected at ${m2.location}`).join("\n")}

The execution phase must produce these artifacts. Go back and create them, then call haiku_run_next again.`
      };
    }
    break;
  }
  return null;
}
function loadCrossStageAgents(studio, stage, agents) {
  const stageDef = readStageDef(studio, stage);
  if (stageDef?.data?.["review-agents-include"] && Array.isArray(stageDef.data["review-agents-include"])) {
    const includes = stageDef.data["review-agents-include"];
    for (const inc of includes) {
      if (!inc.stage || !Array.isArray(inc.agents)) continue;
      const crossAgents = readReviewAgentDefs(studio, inc.stage);
      for (const agentName of inc.agents) {
        if (crossAgents[agentName] && !agents[agentName]) {
          agents[`${agentName} (from ${inc.stage})`] = crossAgents[agentName];
        }
      }
    }
  }
}
function buildOutputRequirements(studio, stage, heading = "## Output Requirements", subheadingLevel = "###") {
  const artifactDefs = readStageArtifactDefs(studio, stage);
  const outputDefs = artifactDefs.filter((d) => d.kind === "output");
  if (outputDefs.length === 0) return "";
  const parts = [heading];
  for (const od of outputDefs) {
    parts.push(
      `${subheadingLevel} ${od.name}${od.required ? " (REQUIRED)" : ""}
**Location:** \`${od.location}\` | **Format:** ${od.format}

${od.body}`
    );
  }
  return parts.join("\n\n");
}
function readPhaseOverride(studio, stage, phase) {
  validateIdentifier(studio, "studio");
