import { readFileSync as readFileSync17 } from "node:fs";
function readStdin() {
  try {
    return readFileSync17(0, "utf8");
  } catch {
    return "";
  }
}
async function runHook(name, _args) {
  const input = readStdin();
  let parsed = {};
  try {
    if (input.trim()) parsed = JSON.parse(input);
  } catch {
  }
  const { resolvePluginRoot: resolvePluginRoot2 } = await Promise.resolve().then(() => (init_config(), config_exports));
  const pluginRoot = resolvePluginRoot2();
  switch (name) {
    case "prompt-guard":
      await promptGuard(parsed, pluginRoot);
      break;
    case "workflow-guard":
      await workflowGuard(parsed, pluginRoot);
      break;
    case "redirect-plan-mode":
      await redirectPlanMode(parsed, pluginRoot);
      break;
    case "context-monitor":
      await contextMonitor(parsed, pluginRoot);
      break;
    case "enforce-iteration":
      await enforceIteration(parsed, pluginRoot);
      break;
    case "ensure-deps":
      await ensureDeps(parsed, pluginRoot);
      break;
    case "quality-gate":
      await qualityGate(parsed, pluginRoot);
      break;
    case "subagent-hook":
      await subagentHook(parsed, pluginRoot);
      break;
    case "subagent-context":
      await generateSubagentContext(parsed, pluginRoot);
      break;
    case "inject-context":
      await injectContext(parsed, pluginRoot);
      break;
    case "inject-state-file":
      await injectStateFile(parsed);
      break;
    case "guard-fsm-fields":
      await guardFsmFields(parsed);
      break;
    case "track-outputs":
      await trackOutputs(parsed, pluginRoot);
      break;
    default:
      console.error(
        `haiku: hook '${name}' not implemented in binary \u2014 use shell fallback`
      );
      process.exit(2);
  }
}
var init_hooks = __esm({
  "src/hooks/index.ts"() {
    "use strict";
    init_context_monitor();
    init_enforce_iteration();
    init_ensure_deps();
    init_guard_fsm_fields();
    init_inject_context();
    init_inject_state_file();
    init_prompt_guard();
    init_quality_gate();
    init_redirect_plan_mode();
    init_subagent_context();
    init_subagent_hook();
    init_track_outputs();
    init_workflow_guard();
  }
});

// src/migrate.ts
var migrate_exports = {};
__export(migrate_exports, {
  runMigrate: () => runMigrate
});
import {
  cpSync,
  existsSync as existsSync20,
  mkdirSync as mkdirSync8,
  readFileSync as readFileSync18,
  readdirSync as readdirSync14,
  writeFileSync as writeFileSync8
} from "node:fs";
import { basename as basename6, join as join31 } from "node:path";
function readFrontmatter2(filePath) {
  const raw = readFileSync18(filePath, "utf8");
  const match = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
  if (!match) return { data: {}, body: raw };
  const data = {};
  for (const line of match[1].split("\n")) {
    const kv = line.match(/^([\w][\w-]*):\s*(.*)$/);
    if (kv) {
      const [, k2, v2] = kv;
      if (v2 === "null") data[k2] = null;
      else if (v2 === "true") data[k2] = true;
      else if (v2 === "false") data[k2] = false;
      else if (/^-?\d+$/.test(v2)) data[k2] = Number.parseInt(v2, 10);
      else if (v2.startsWith("[") && v2.endsWith("]")) {
        data[k2] = v2.slice(1, -1).split(",").map((s) => s.trim().replace(/^["']|["']$/g, "")).filter(Boolean);
      } else data[k2] = v2.replace(/^["']|["']$/g, "");
    }
  }
  return { data, body: match[2].trim() };
}
function timestamp2() {
  return (/* @__PURE__ */ new Date()).toISOString().replace(/\.\d{3}Z$/, "Z");
}
function gitFirstCommitDate(path) {
  try {
    const { execSync: execSync6 } = __require("node:child_process");
    const result = execSync6(
      `git log --diff-filter=A --follow --format=%aI -- "${path}" | tail -1`,
      {
        encoding: "utf8",
        timeout: 5e3,
        cwd: process.cwd()
      }
    ).trim();
    return result || null;
  } catch {
    return null;
  }
}
function gitLastCommitDate(path) {
  try {
    const { execSync: execSync6 } = __require("node:child_process");
    const result = execSync6(`git log -1 --format=%aI -- "${path}"`, {
      encoding: "utf8",
      timeout: 5e3,
      cwd: process.cwd()
    }).trim();
    return result || null;
  } catch {
    return null;
  }
}
async function runMigrate(args2) {
  const dryRun = args2.includes("--dry-run");
  const cwd2 = process.cwd();
  const oldDir = join31(cwd2, ".ai-dlc");
  const newDir = join31(cwd2, ".haiku", "intents");
  if (!existsSync20(oldDir)) {
    console.log("No .ai-dlc/ directory found. Nothing to migrate.");
    return;
  }
  const entries = readdirSync14(oldDir).filter((d) => {
    const path = join31(oldDir, d);
    return existsSync20(join31(path, "intent.md"));
  });
  if (entries.length === 0) {
    console.log("No intents found in .ai-dlc/. Nothing to migrate.");
    return;
  }
  const passSuffixes = ["-dev", "-product", "-design", "-tests"];
  const mergeMap = /* @__PURE__ */ new Map();
  const mergedSlugs = /* @__PURE__ */ new Set();
  const followupSuffixes = ["-followup", "-v2", "-phase2"];
  const followsMap = /* @__PURE__ */ new Map();
  for (const slug of entries) {
    for (const suffix of passSuffixes) {
      if (slug.endsWith(suffix)) {
        const base = slug.slice(0, -suffix.length);
        if (entries.includes(base)) {
          if (!mergeMap.has(base)) mergeMap.set(base, []);
          mergeMap.get(base)?.push(slug);
          mergedSlugs.add(slug);
        }
      }
    }
  }
  for (const slug of entries) {
    if (mergedSlugs.has(slug)) continue;
    for (const suffix of followupSuffixes) {
      if (slug.endsWith(suffix)) {
        const parent = slug.slice(0, -suffix.length);
        if (entries.includes(parent)) {
          followsMap.set(slug, parent);
        }
      }
    }
  }
  if (mergeMap.size > 0) {
    console.log(`Detected ${mergeMap.size} multi-pass intent group(s):`);
    for (const [base, related] of mergeMap) {
      console.log(`  ${base} \u2190 [${related.join(", ")}]`);
    }
    console.log();
  }
  if (followsMap.size > 0) {
    console.log(`Detected ${followsMap.size} follow-up intent(s):`);
    for (const [slug, parent] of followsMap) {
      console.log(`  ${slug} follows ${parent}`);
    }
    console.log();
  }
  const primarySlugs = entries.filter((s) => !mergedSlugs.has(s));
  console.log(
    `Found ${entries.length} intent(s) to migrate (${primarySlugs.length} primary, ${mergedSlugs.size} merged).
`
  );
  let migrated = 0;
  let skipped = 0;
  for (const slug of primarySlugs) {
    const srcDir = join31(oldDir, slug);
    const destDir = join31(newDir, slug);
    const force = args2.includes("--force");
    if (existsSync20(destDir)) {
      const hasStages = existsSync20(join31(destDir, "stages"));
      if (hasStages && !force) {
        console.log(`  SKIP: ${slug} (already migrated with stages)`);
        skipped++;
        continue;
      }
      if (!hasStages) {
        console.log(`  RE-MIGRATE: ${slug} (missing stages \u2014 upgrading)`);
      }
    }
    const { data: intentFm, body: intentBody } = readFrontmatter2(
      join31(srcDir, "intent.md")
    );
    const status = intentFm.status || "active";
    const title = intentBody.match(/^# (.+)$/m)?.[1] || slug;
    const parentSlug = followsMap.get(slug) || "";
    const gitCreated = gitFirstCommitDate(join31(srcDir, "intent.md"));
    const gitLastModified = gitLastCommitDate(srcDir);
    const fmCreated = intentFm.created || "";
    const startedAt = gitCreated || (fmCreated ? `${fmCreated}T00:00:00Z` : timestamp2());
    const completedAt = status === "completed" || status === "complete" ? gitLastModified || startedAt : null;
    if (dryRun) {
      console.log(`  DRY RUN: ${slug} (status: ${status})`);
      migrated++;
      continue;
    }
    mkdirSync8(join31(destDir, "knowledge"), { recursive: true });
    const allStages = [
      "inception",
      "design",
      "product",
      "development",
      "operations",
      "security"
    ];
    const passToStage = {
      design: "design",
      dev: "development",
      product: "product",
      ops: "operations",
      security: "security"
    };
    const sourceDirs = [
      { dir: srcDir, defaultStage: "" }
      // primary — uses pass: field
    ];
    const relatedSlugs = mergeMap.get(slug) || [];
    const suffixToStage = {
      "-dev": "development",
      "-product": "product",
      "-design": "design",
      "-tests": "development"
    };
    for (const related of relatedSlugs) {
      const relatedDir = join31(oldDir, related);
      const suffix = passSuffixes.find((s) => related.endsWith(s)) || "";
      sourceDirs.push({
        dir: relatedDir,
        defaultStage: suffixToStage[suffix] || "development"
      });
    }
    const unitsByStage = /* @__PURE__ */ new Map();
    let totalUnitCount = 0;
    for (const { dir: sourceDir, defaultStage } of sourceDirs) {
      const unitFiles = readdirSync14(sourceDir).filter(
        (f) => f.startsWith("unit-") && f.endsWith(".md")
      );
      for (const unitFile of unitFiles) {
        const { data: unitFm, body: unitBody } = readFrontmatter2(
          join31(sourceDir, unitFile)
        );
        const pass = unitFm.pass || "";
        const stage = pass ? passToStage[pass] || "development" : defaultStage || "development";
        if (!unitsByStage.has(stage)) unitsByStage.set(stage, []);
        unitsByStage.get(stage)?.push({ file: unitFile, fm: unitFm, body: unitBody });
        totalUnitCount++;
      }
      if (sourceDir !== srcDir) {
        if (existsSync20(join31(sourceDir, "discovery.md"))) {
          const relSlug = basename6(sourceDir);
          if (!dryRun) {
            cpSync(
              join31(sourceDir, "discovery.md"),
              join31(destDir, "knowledge", `${relSlug}-discovery.md`)
            );
          }
        }
        if (existsSync20(join31(sourceDir, "mockups")) && !dryRun) {
          const artifactsDir = join31(destDir, "stages", "design", "artifacts");
          mkdirSync8(artifactsDir, { recursive: true });
          try {
            cpSync(join31(sourceDir, "mockups"), artifactsDir, {
              recursive: true
            });
          } catch {
          }
        }
      }
    }
    const activePass = intentFm.active_pass || "";
    const mappedStage = activePass ? passToStage[activePass] || "" : "";
    const epic = intentFm.epic || "";
    if (status === "completed" || status === "complete") {
      writeFileSync8(
        join31(destDir, "intent.md"),
        `---
title: "${title}"
studio: software
stages: [inception, design, product, development, operations, security]
mode: continuous
active_stage: security
status: completed
started_at: ${startedAt}
completed_at: ${completedAt}${epic ? `
epic: ${epic}` : ""}${parentSlug ? `
follows: ${parentSlug}` : ""}
---

${intentBody}
`
      );
      for (const stage of allStages) {
        mkdirSync8(join31(destDir, "stages", stage, "units"), { recursive: true });
        writeFileSync8(
          join31(destDir, "stages", stage, "state.json"),
          `${JSON.stringify({ stage, status: "completed", phase: "gate", started_at: `${startedAt}`, completed_at: `${completedAt}`, gate_entered_at: null, gate_outcome: "advanced" }, null, 2)}
`
        );
      }
      for (const [stage, units] of unitsByStage) {
        mkdirSync8(join31(destDir, "stages", stage, "units"), { recursive: true });
        for (const { file, fm, body } of units) {
          const uStatus = fm.status || "pending";
          const uDeps = fm.depends_on || [];
          const uDiscipline = fm.discipline || "fullstack";
          const uUpdated = fm.last_updated || gitFirstCommitDate(join31(srcDir, file)) || null;
          const uTicket = fm.ticket || "";
          const uBranch = fm.branch || "";
          writeFileSync8(
            join31(destDir, "stages", stage, "units", file),
            `---
name: ${basename6(file, ".md")}
type: ${uDiscipline}
status: ${uStatus}
depends_on: [${uDeps.join(", ")}]
bolt: 0
hat: ""${uTicket ? `
ticket: ${uTicket}` : ""}${uBranch ? `
branch: ${uBranch}` : ""}
started_at: ${uUpdated || "null"}
completed_at: ${uStatus === "completed" ? uUpdated || "null" : "null"}
---

${body}
`
          );
        }
      }
      const mergeNote = relatedSlugs.length > 0 ? ` [merged: ${relatedSlugs.join(", ")}]` : "";
      console.log(
        `  MIGRATED: ${slug} (completed, ${totalUnitCount} units across ${unitsByStage.size} stage(s))${mergeNote}`
      );
    } else {
      const skipStages = allStages.filter((s) => {
        if (!unitsByStage.has(s) && s !== mappedStage) return false;
        return false;
      });
      const firstStageWithUnits = allStages.find((s) => unitsByStage.has(s)) || "";
      writeFileSync8(
        join31(destDir, "intent.md"),
        `---
title: "${title}"
studio: software
stages: [inception, design, product, development, operations, security]
mode: continuous
active_stage: ${firstStageWithUnits || '""'}
status: active
started_at: ${startedAt}
completed_at: null${epic ? `
epic: ${epic}` : ""}${parentSlug ? `
follows: ${parentSlug}` : ""}
---

${intentBody}
`
      );
      for (const stage of allStages) {
        mkdirSync8(join31(destDir, "stages", stage, "units"), { recursive: true });
        if (unitsByStage.has(stage)) {
          writeFileSync8(
            join31(destDir, "stages", stage, "state.json"),
            `${JSON.stringify(
              {
                stage,
                status: stage === firstStageWithUnits ? "active" : "pending",
                phase: stage === firstStageWithUnits ? "execute" : "",
                started_at: startedAt,
                completed_at: null,
                gate_entered_at: null,
                gate_outcome: null
              },
              null,
              2
            )}
`
          );
        }
      }
      for (const [stage, units] of unitsByStage) {
        for (const { file, fm, body } of units) {
          const uStatus = fm.status || "pending";
          const uDeps = fm.depends_on || [];
          const uDiscipline = fm.discipline || "fullstack";
          const uUpdated = fm.last_updated || gitFirstCommitDate(join31(srcDir, file)) || null;
          const uTicket = fm.ticket || "";
          const uBranch = fm.branch || "";
          writeFileSync8(
            join31(destDir, "stages", stage, "units", file),
            `---
name: ${basename6(file, ".md")}
type: ${uDiscipline}
status: ${uStatus}
depends_on: [${uDeps.join(", ")}]
bolt: 0
hat: ""${uTicket ? `
ticket: ${uTicket}` : ""}${uBranch ? `
branch: ${uBranch}` : ""}
started_at: ${uUpdated || "null"}
completed_at: ${uStatus === "completed" ? uUpdated || "null" : "null"}
---

${body}
`
          );
        }
      }
      const mergeNoteActive = relatedSlugs.length > 0 ? ` [merged: ${relatedSlugs.join(", ")}]` : "";
      console.log(
        `  MIGRATED: ${slug} (active, stage: ${mappedStage || "inception"}, ${totalUnitCount} units across ${unitsByStage.size} stage(s))${mergeNoteActive}`
      );
    }
    if (existsSync20(join31(srcDir, "discovery.md"))) {
      cpSync(
        join31(srcDir, "discovery.md"),
        join31(destDir, "knowledge", "DISCOVERY.md")
      );
    }
    if (existsSync20(join31(srcDir, "knowledge"))) {
      try {
        cpSync(join31(srcDir, "knowledge"), join31(destDir, "knowledge"), {
          recursive: true
        });
      } catch {
      }
    }
    if (existsSync20(join31(srcDir, "mockups"))) {
      const artifactsDir = join31(destDir, "stages", "design", "artifacts");
      mkdirSync8(artifactsDir, { recursive: true });
      try {
        cpSync(join31(srcDir, "mockups"), artifactsDir, { recursive: true });
      } catch {
      }
    }
    migrated++;
  }
  console.log(`
Migration complete: ${migrated} migrated, ${skipped} skipped.`);
  if (dryRun) {
    console.log(
      "(Dry run \u2014 no files were written. Run without --dry-run to migrate.)"
    );
  } else {
    console.log("\nNext steps:");
    console.log(
      "  git add .haiku/intents/ && git commit -m 'haiku: migrate intents from .ai-dlc/'"
    );
    console.log(
      "  For active intents: run /haiku:pickup to start from inception"
    );
  }
}
