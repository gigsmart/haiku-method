// src/hooks/subagent-hook.ts
async function subagentHook(input, pluginRoot) {
  const toolName = input.tool_name;
  const caps = getCapabilities();
  const agentToolNames = new Set(caps.subagents.toolNames);
  const isAgentTool = toolName === "Agent" || toolName === "Task" || agentToolNames.has(toolName);
  const isSkillTool = toolName === "Skill";
  const targetField = isAgentTool ? "prompt" : isSkillTool ? "args" : "prompt";
  let toolInput = input.tool_input ?? {};
  if (!toolInput || typeof toolInput !== "object") toolInput = {};
  const originalValue = String(toolInput[targetField] ?? "");
  if (isAgentTool && !originalValue) return;
  if (originalValue.includes("<subagent-context>")) return;
  const contextOutput = await generateSubagentContextString(pluginRoot);
  const permissionMode = isAgentTool ? input.permission_mode ?? "" : "";
  if (!contextOutput && !permissionMode) return;
  const updatedInput = { ...toolInput };
  if (contextOutput) {
    const wrappedContext = `<subagent-context>
${contextOutput}
</subagent-context>

`;
    const modifiedValue = wrappedContext + originalValue;
    updatedInput[targetField] = modifiedValue;
  }
  if (permissionMode) {
    updatedInput.mode = permissionMode;
  }
  if (isAgentTool) {
    const currentType = updatedInput.subagent_type ?? "";
    if (currentType === "Plan") {
      updatedInput.subagent_type = "general-purpose";
    }
    if (!currentType || currentType === "general-purpose") {
      if (!updatedInput.description) {
        updatedInput.description = "H\xB7AI\xB7K\xB7U work";
      }
    }
  }
  const response = {
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      updatedInput
    }
  };
  process.stdout.write(JSON.stringify(response));
}
async function generateSubagentContextString(pluginRoot) {
  let captured = "";
  const origWrite = process.stdout.write.bind(process.stdout);
  process.stdout.write = ((chunk) => {
    captured += typeof chunk === "string" ? chunk : chunk.toString();
    return true;
  });
  try {
    await generateSubagentContext({}, pluginRoot);
  } catch {
  } finally {
    process.stdout.write = origWrite;
  }
  return captured;
}
var init_subagent_hook = __esm({
  "src/hooks/subagent-hook.ts"() {
    "use strict";
    init_harness();
    init_subagent_context();
  }
});

// src/hooks/track-outputs.ts
import { existsSync as existsSync18, readFileSync as readFileSync16, readdirSync as readdirSync12, writeFileSync as writeFileSync7 } from "node:fs";
import { join as join29, relative as relative2, resolve as resolve8 } from "node:path";
async function trackOutputs(input, _pluginRoot2) {
  const toolInput = input.tool_input || {};
  const filePath = toolInput.file_path || "";
  if (!filePath) return;
  const absPath = resolve8(process.cwd(), filePath);
  const intentMatch = absPath.match(/\.haiku\/intents\/([^/]+)\/(.+)$/);
  if (!intentMatch) return;
  const [, intentSlug, intentRelPath] = intentMatch;
  const stageMatch = intentRelPath.match(/^stages\/([^/]+)\/(.+)$/);
  const knowledgeMatch = intentRelPath.match(/^knowledge\/(.+)$/);
  if (!stageMatch && !knowledgeMatch) return;
  if (stageMatch) {
    const rest = stageMatch[2];
    if (rest.startsWith("units/")) return;
    if (rest === "state.json") return;
  }
  const intentDir3 = join29(process.cwd(), ".haiku", "intents", intentSlug);
  if (!existsSync18(intentDir3)) return;
  const relPath = relative2(intentDir3, absPath);
  const targetStage = stageMatch ? stageMatch[1] : null;
  const activeUnitPath = targetStage ? findActiveUnitInStage2(intentDir3, targetStage) || findAnyActiveUnit(intentDir3) : findAnyActiveUnit(intentDir3);
  if (!activeUnitPath) return;
  const unitRaw = readFileSync16(activeUnitPath, "utf8");
  const { data, content } = (0, import_gray_matter6.default)(unitRaw);
  const outputs = data.outputs || [];
  if (outputs.includes(relPath)) return;
  outputs.push(relPath);
  data.outputs = outputs;
  const updated = import_gray_matter6.default.stringify(content, data);
  writeFileSync7(activeUnitPath, updated);
}
function findActiveUnitInStage2(intentDir3, stage) {
  const unitsDir = join29(intentDir3, "stages", stage, "units");
  if (!existsSync18(unitsDir)) return null;
  for (const f of readdirSync12(unitsDir).filter((u3) => u3.endsWith(".md"))) {
    const unitPath2 = join29(unitsDir, f);
    const { data } = (0, import_gray_matter6.default)(readFileSync16(unitPath2, "utf8"));
    if (data.status === "active") return unitPath2;
  }
  return null;
}
function findAnyActiveUnit(intentDir3) {
  const stagesDir = join29(intentDir3, "stages");
  if (!existsSync18(stagesDir)) return null;
  for (const stage of readdirSync12(stagesDir, { withFileTypes: true })) {
    if (!stage.isDirectory()) continue;
    const found = findActiveUnitInStage2(intentDir3, stage.name);
    if (found) return found;
  }
  return null;
}
