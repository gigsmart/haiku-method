}
function resolveStageReview(studio, stage) {
  const info = resolveStudio(studio);
  const dir = info ? info.dir : studio;
  const pluginRoot = resolvePluginRoot();
  for (const base of [
    join18(process.cwd(), ".haiku", "studios"),
    join18(pluginRoot, "studios")
  ]) {
    const stageFile = join18(base, dir, "stages", stage, "STAGE.md");
    if (existsSync11(stageFile)) {
      const fm = readFrontmatter(stageFile);
      const review2 = fm.review;
      if (Array.isArray(review2)) return review2.join(",");
      return review2 || "auto";
    }
  }
  return "auto";
}
function stageReviewIncludes(studio, stage, kind) {
  const info = resolveStudio(studio);
