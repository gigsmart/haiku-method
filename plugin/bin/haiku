// ../../node_modules/@sentry/core/build/esm/utils/cookie.js
function parseCookie(str3) {
  const obj = {};
  let index = 0;
  while (index < str3.length) {
    const eqIdx = str3.indexOf("=", index);
    if (eqIdx === -1) {
      break;
    }
    let endIdx = str3.indexOf(";", index);
    if (endIdx === -1) {
      endIdx = str3.length;
    } else if (endIdx < eqIdx) {
      index = str3.lastIndexOf(";", eqIdx - 1) + 1;
      continue;
    }
    const key = str3.slice(index, eqIdx).trim();
    if (void 0 === obj[key]) {
      let val = str3.slice(eqIdx + 1, endIdx).trim();
      if (val.charCodeAt(0) === 34) {
        val = val.slice(1, -1);
      }
      try {
        obj[key] = val.indexOf("%") !== -1 ? decodeURIComponent(val) : val;
      } catch {
        obj[key] = val;
      }
    }
    index = endIdx + 1;
  }
  return obj;
}
