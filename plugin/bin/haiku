// src/auto-update.ts
import { spawn } from "node:child_process";
import {
  chmodSync,
  copyFileSync,
  createWriteStream,
  existsSync as existsSync3,
  mkdirSync,
  renameSync,
  unlinkSync
} from "node:fs";
import { tmpdir } from "node:os";
import { join as join6 } from "node:path";
import { Readable as Readable2 } from "node:stream";
import { pipeline } from "node:stream/promises";
function hasPendingUpdate() {
  return pendingBinaryPath !== null;
}
function getPendingVersion() {
  return pendingVersion;
}
function parseSemver2(v2) {
  const m2 = /^(\d+)\.(\d+)\.(\d+)/.exec(v2);
  if (!m2) return null;
  return [Number(m2[1]), Number(m2[2]), Number(m2[3])];
}
function isNewer(latest, current) {
  const a = parseSemver2(latest);
  const b2 = parseSemver2(current);
  if (!a || !b2) return false;
  if (a[0] !== b2[0]) return a[0] > b2[0];
  if (a[1] !== b2[1]) return a[1] > b2[1];
  return a[2] > b2[2];
}
async function fetchLatestRelease() {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 15e3);
  try {
    const res = await fetch(
      `https://api.github.com/repos/${GITHUB_REPO}/releases/latest`,
      {
        headers: {
          Accept: "application/vnd.github+json",
          "User-Agent": `haiku-mcp/${MCP_VERSION}`
        },
        signal: controller.signal
      }
    );
    if (!res.ok) return null;
    return await res.json();
  } catch {
    return null;
  } finally {
    clearTimeout(timeout);
  }
}
async function downloadBinary(url, version3) {
  const stagingDir = join6(tmpdir(), "haiku-update");
  if (!existsSync3(stagingDir)) mkdirSync(stagingDir, { recursive: true });
  const dest = join6(stagingDir, `haiku-${version3}`);
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 12e4);
  try {
    const res = await fetch(url, { signal: controller.signal });
    if (!res.ok || !res.body) throw new Error(`HTTP ${res.status}`);
    const ws = createWriteStream(dest);
    await pipeline(Readable2.fromWeb(res.body), ws);
    chmodSync(dest, 493);
    return dest;
  } catch (err) {
    try {
      unlinkSync(dest);
    } catch {
    }
    throw err;
  } finally {
    clearTimeout(timeout);
  }
}
async function checkForUpdate() {
  if (checking || pendingBinaryPath) return;
  checking = true;
  try {
    if (MCP_VERSION === "dev") return;
    const release2 = await fetchLatestRelease();
    if (!release2) return;
    const latestVersion = release2.tag_name.replace(/^v/, "");
    if (!isNewer(latestVersion, MCP_VERSION)) return;
    const binaryAsset = release2.assets.find(
      (a) => a.name === "haiku" || a.name === "haiku-mcp"
    );
    if (binaryAsset) {
      const path = await downloadBinary(
        binaryAsset.browser_download_url,
        latestVersion
      );
      pendingBinaryPath = path;
      pendingVersion = latestVersion;
      console.error(
        `[haiku] Update downloaded: ${MCP_VERSION} -> ${latestVersion}`
      );
      return;
    }
    const zipAsset = release2.assets.find((a) => a.name.endsWith(".zip"));
    if (!zipAsset) return;
    const binaryPath = await downloadAndExtractFromZip(
      zipAsset.browser_download_url,
      latestVersion
    );
    if (binaryPath) {
      pendingBinaryPath = binaryPath;
      pendingVersion = latestVersion;
      console.error(
        `[haiku] Update downloaded: ${MCP_VERSION} -> ${latestVersion}`
      );
    }
  } catch (err) {
    reportError(err, { context: "auto-update-check" });
  } finally {
    checking = false;
  }
}
async function downloadAndExtractFromZip(url, version3) {
  const stagingDir = join6(tmpdir(), "haiku-update");
  if (!existsSync3(stagingDir)) mkdirSync(stagingDir, { recursive: true });
  const zipPath = join6(stagingDir, `haiku-${version3}.zip`);
  const binaryDest = join6(stagingDir, `haiku-${version3}`);
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 12e4);
  try {
    const res = await fetch(url, { signal: controller.signal });
    if (!res.ok || !res.body) throw new Error(`HTTP ${res.status}`);
    const ws = createWriteStream(zipPath);
    await pipeline(Readable2.fromWeb(res.body), ws);
    const result = spawn(
      "unzip",
      ["-o", "-j", zipPath, "plugin/bin/haiku", "-d", stagingDir],
      { stdio: "pipe" }
    );
    await new Promise((resolve9, reject) => {
      result.on(
        "close",
        (code) => code === 0 ? resolve9() : reject(new Error(`unzip exited with ${code}`))
      );
      result.on("error", (err) => {
        if (err.code === "ENOENT") {
          console.error(
            "[haiku] Auto-update zip fallback requires 'unzip' (not found in PATH)"
          );
        }
        reject(err);
      });
    });
    const extractedPath = join6(stagingDir, "haiku");
    if (existsSync3(extractedPath)) {
      renameSync(extractedPath, binaryDest);
      chmodSync(binaryDest, 493);
    }
    return existsSync3(binaryDest) ? binaryDest : null;
  } catch (err) {
    reportError(err, { context: "auto-update-zip-extract" });
    return null;
  } finally {
    clearTimeout(timeout);
    try {
      unlinkSync(zipPath);
    } catch {
    }
  }
}
function execNewBinary() {
  const newBinary = pendingBinaryPath;
  const currentBinary = process.argv[1];
  let execPath = newBinary;
  try {
    const dest = currentBinary;
    const tempDest = `${dest}.updating`;
    copyFileSync(newBinary, tempDest);
    chmodSync(tempDest, 493);
    renameSync(tempDest, dest);
    execPath = dest;
    try {
      unlinkSync(newBinary);
    } catch {
    }
    console.error(`[haiku] Binary replaced on disk: ${dest}`);
  } catch (err) {
    console.error("[haiku] Could not replace binary on disk:", err);
  }
  console.error(
    `[haiku] Yielding to updated binary (${MCP_VERSION} -> ${pendingVersion})`
  );
  const child = spawn(execPath, ["mcp"], {
    stdio: "inherit",
    env: process.env
  });
  child.on("exit", (code) => process.exit(code ?? 0));
  child.on("error", (err) => {
    console.error("[haiku] Hot-swap spawn failed:", err);
    process.exit(1);
  });
}
function startUpdateChecker() {
  if (!autoUpdate.enabled) {
    console.error("[haiku] Auto-update disabled (HAIKU_AUTO_UPDATE=0)");
    return;
  }
  if (MCP_VERSION === "dev") {
    console.error("[haiku] Auto-update skipped (dev build)");
    return;
  }
  console.error(
    `[haiku] Auto-update enabled (check every ${Math.round(autoUpdate.intervalMs / 6e4)}m)`
  );
  timer = setTimeout(async () => {
    timer = setInterval(checkForUpdate, autoUpdate.intervalMs);
    await checkForUpdate();
  }, autoUpdate.initialDelayMs);
}
function stopUpdateChecker() {
  if (timer) {
    clearInterval(timer);
    clearTimeout(timer);
    timer = null;
  }
}
var GITHUB_REPO, pendingBinaryPath, pendingVersion, checking, timer;
var init_auto_update = __esm({
  "src/auto-update.ts"() {
    "use strict";
    init_config();
    init_sentry();
    init_version3();
    GITHUB_REPO = "gigsmart/haiku-method";
    pendingBinaryPath = null;
    pendingVersion = null;
    checking = false;
    timer = null;
  }
});

