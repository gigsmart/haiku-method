function readFrontmatter(filePath) {
  if (!existsSync11(filePath)) return {};
  const raw = readFileSync10(filePath, "utf8");
  const { data } = parseFrontmatter(raw);
  return data;
}
function resolveStudioStages(studio) {
  const info = resolveStudio(studio);
  if (info) return info.stages;
  const pluginRoot = resolvePluginRoot();
  for (const base of [
    join18(process.cwd(), ".haiku", "studios"),
    join18(pluginRoot, "studios")
  ]) {
    const studioFile = join18(base, studio, "STUDIO.md");
    if (existsSync11(studioFile)) {
      const fm = readFrontmatter(studioFile);
      return fm.stages || [];
    }
  }
  return [];
}
