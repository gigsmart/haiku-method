// src/main.ts
init_sentry();
var [cmd, ...args] = process.argv.slice(2);
if (cmd === "mcp") {
  let harnessName = "";
  const filteredArgs = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === "--harness" && i + 1 < args.length) {
      harnessName = args[++i];
    } else if (args[i].startsWith("--harness=")) {
      harnessName = args[i].split("=", 2)[1];
    } else {
      filteredArgs.push(args[i]);
    }
  }
  if (!harnessName) {
    harnessName = process.env.HAIKU_HARNESS || "";
  }
  const harnessReady = harnessName ? Promise.resolve().then(() => (init_harness(), harness_exports)).then((m2) => m2.setHarness(harnessName)) : Promise.resolve();
  harnessReady.then(() => Promise.resolve().then(() => (init_server3(), server_exports))).catch((err) => {
    reportError(err);
    console.error(`haiku mcp: ${err.message}`);
    process.exit(1);
  });
} else if (cmd === "hook") {
  const hookName = args[0];
  if (!hookName) {
    console.error("Usage: haiku hook <name>");
    process.exit(1);
  }
  Promise.resolve().then(() => (init_hooks(), hooks_exports)).then((m2) => m2.runHook(hookName, args.slice(1))).catch((err) => {
    console.error(`haiku hook ${hookName}: ${err.message}`);
    process.exit(1);
  });
} else if (cmd === "migrate") {
  Promise.resolve().then(() => (init_migrate(), migrate_exports)).then((m2) => m2.runMigrate(args)).catch((err) => {
    console.error(`haiku migrate: ${err.message}`);
    process.exit(1);
  });
} else {
  console.error("Usage: haiku <mcp|hook|migrate> [args...]");
  process.exit(1);
}
