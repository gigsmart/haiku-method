      }
    });
  }
}
function instrumentMethod2(originalMethod, methodPath, instrumentedMethod, context2, options2) {
  return new Proxy(originalMethod, {
    apply(target, thisArg, args2) {
      const operationName = instrumentedMethod.operation;
      const requestAttributes = extractRequestAttributes2(args2, methodPath, operationName);
      const model = requestAttributes[GEN_AI_REQUEST_MODEL_ATTRIBUTE] ?? "unknown";
      const params = typeof args2[0] === "object" ? args2[0] : void 0;
      const isStreamRequested = Boolean(params?.stream);
      const isStreamingMethod = instrumentedMethod.streaming === true;
      if (isStreamRequested || isStreamingMethod) {
        return handleStreamingRequest(
          originalMethod,
          target,
          context2,
          args2,
          requestAttributes,
          operationName,
          methodPath,
          params,
          options2,
          isStreamRequested,
          isStreamingMethod
        );
      }
      let originalResult;
      const instrumentedPromise = startSpan(
        {
          name: `${operationName} ${model}`,
          op: `gen_ai.${operationName}`,
          attributes: requestAttributes
        },
        (span) => {
          originalResult = target.apply(context2, args2);
          if (options2.recordInputs && params) {
            addPrivateRequestAttributes(span, params);
          }
          return originalResult.then(
            (result) => {
              addResponseAttributes2(span, result, options2.recordOutputs);
              return result;
            },
            (error4) => {
              captureException(error4, {
                mechanism: {
                  handled: false,
                  type: "auto.ai.anthropic",
                  data: {
                    function: methodPath
                  }
                }
              });
              throw error4;
            }
          );
        }
      );
      return wrapPromiseWithMethods(originalResult, instrumentedPromise, "auto.ai.anthropic");
    }
  });
}
function createDeepProxy2(target, currentPath = "", options2) {
  return new Proxy(target, {
    get(obj, prop) {
      const value = obj[prop];
      const methodPath = buildMethodPath(currentPath, String(prop));
      const instrumentedMethod = ANTHROPIC_METHOD_REGISTRY[methodPath];
      if (typeof value === "function" && instrumentedMethod) {
        return instrumentMethod2(
          value,
          methodPath,
          instrumentedMethod,
          obj,
          options2
        );
      }
      if (typeof value === "function") {
        return value.bind(obj);
      }
      if (value && typeof value === "object") {
        return createDeepProxy2(value, methodPath, options2);
      }
      return value;
    }
  });
}
