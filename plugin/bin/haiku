      _pluginRoot = candidate;
      process.env.CLAUDE_PLUGIN_ROOT = candidate;
      console.error(`[haiku] Self-resolved plugin root: ${candidate}`);
      return _pluginRoot;
    }
  }
  _pluginRoot = "";
  return _pluginRoot;
}
