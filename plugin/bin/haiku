// src/parser.ts
import { readFile as readFile3, readdir as readdir2 } from "node:fs/promises";
import { basename as basename2, join as join8 } from "node:path";
function matterWithDedupe(raw, filePath) {
  try {
    return (0, import_gray_matter.default)(raw);
  } catch (err) {
    if (!isDuplicateKeyError(err)) throw err;
    const { text, removed } = dedupeFrontmatterKeys(raw);
    if (removed.length === 0) throw err;
    const parsed = (0, import_gray_matter.default)(text);
    console.warn(
      `[haiku] Recovered duplicate YAML keys in ${filePath}: kept last occurrence of ${removed.join(", ")}`
    );
    return parsed;
  }
}
function normalizeFrontmatter(data) {
  const result = { ...data };
  for (const key in result) {
    const val = result[key];
    if (val instanceof Date) {
      ;
      result[key] = val.toISOString().split("T")[0];
    }
  }
  return result;
}
function extractTitle(body) {
  const match = body.match(/^# (.+)$/m);
  return match ? match[1].trim() : "";
}
function stripTitle(body) {
  return body.replace(/^# .+$/m, "").trim();
}
async function parseIntent(intentDir3) {
  try {
    const filePath = join8(intentDir3, "intent.md");
    const raw = await readFile3(filePath, "utf-8");
    const { data, content } = matterWithDedupe(raw, filePath);
    const frontmatter = normalizeFrontmatter(data);
    const title = extractTitle(content);
    const bodyWithoutTitle = stripTitle(content);
    const sections = extractSections(bodyWithoutTitle);
    const slug = basename2(intentDir3);
    return {
      slug,
      frontmatter,
      title,
      sections,
      rawContent: raw
    };
  } catch (err) {
    const filePath = join8(intentDir3, "intent.md");
    if (err.code !== "ENOENT") {
      console.warn(`[haiku/shared] Failed to parse ${filePath}:`, err);
    }
    return null;
  }
}
async function parseUnit(filePath) {
  try {
    const raw = await readFile3(filePath, "utf-8");
    const { data, content } = matterWithDedupe(raw, filePath);
    const frontmatter = normalizeFrontmatter(data);
    const title = extractTitle(content);
    const bodyWithoutTitle = stripTitle(content);
    const sections = extractSections(bodyWithoutTitle);
    const filename = basename2(filePath, ".md");
    const numberMatch = filename.match(/^unit-(\d+)/);
    const number4 = numberMatch ? Number.parseInt(numberMatch[1], 10) : 0;
    return {
      slug: filename,
      number: number4,
      frontmatter,
      title,
      sections,
      rawContent: raw
    };
  } catch (err) {
    if (err.code !== "ENOENT") {
      console.warn(`[haiku/shared] Failed to parse ${filePath}:`, err);
    }
    return null;
  }
}
async function parseAllUnits(intentDir3) {
  const units = [];
  try {
    const stagesDir = join8(intentDir3, "stages");
    const stageEntries = await readdir2(stagesDir, { withFileTypes: true });
    for (const stageEntry of stageEntries) {
      if (!stageEntry.isDirectory()) continue;
      try {
        const unitsDir = join8(stagesDir, stageEntry.name, "units");
        const unitEntries = await readdir2(unitsDir);
        const unitFiles = unitEntries.filter((f) => /^unit-\d{2,}-[a-z0-9]+(?:-[a-z0-9]+)*\.md$/.test(f)).sort();
        for (const file of unitFiles) {
          const parsed = await parseUnit(join8(unitsDir, file));
          if (parsed) {
            if (!parsed.frontmatter.stage) {
              parsed.frontmatter.stage = stageEntry.name;
            }
            units.push(parsed);
          }
        }
      } catch {
      }
    }
  } catch {
  }
  return units.sort((a, b2) => a.number - b2.number);
}
