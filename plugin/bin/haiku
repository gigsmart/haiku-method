            max: MAX_BOLTS_INC,
            message: `Unit has exceeded ${MAX_BOLTS_INC} bolt iterations. Escalate to the user \u2014 this unit may need to be redesigned or split.`
          })
        );
      }
      setFrontmatterField(path, "bolt", current + 1);
      sealIntentState(args2.intent);
      emitTelemetry("haiku.bolt.iteration", {
        intent: args2.intent,
        stage: args2.stage,
        unit: args2.unit,
        bolt: String(current + 1)
      });
      return text(String(current + 1));
    }
