        }
      }
      if (!changelogPath) return text("No CHANGELOG.md found.");
      const changelog = readFileSync7(changelogPath, "utf8");
      const versionPattern = /^## \[([^\]]+)\]/gm;
      const matches = [];
      let match = versionPattern.exec(changelog);
      while (match !== null) {
        matches.push({ version: match[1], start: match.index });
        match = versionPattern.exec(changelog);
      }
      if (matches.length === 0)
        return text("No versioned entries found in CHANGELOG.md.");
      if (version3) {
        const idx = matches.findIndex((m2) => m2.version === version3);
        if (idx === -1)
          return text(
            `Version '${version3}' not found in CHANGELOG.md. Available: ${matches.slice(0, 10).map((m2) => m2.version).join(", ")}`
          );
        const endIdx = idx + 1 < matches.length ? matches[idx + 1].start : changelog.length;
        const section = changelog.slice(matches[idx].start, endIdx).trim();
        return text(
          `# Release Notes

${section}

---
Total releases in changelog: ${matches.length}`
        );
      }
      const recent = matches.slice(0, 5);
      let out5 = "# Recent Release Notes\n";
      for (let i = 0; i < recent.length; i++) {
        const endIdx = i + 1 < matches.length ? matches[i + 1].start : changelog.length;
        out5 += `
${changelog.slice(recent[i].start, endIdx).trim()}
`;
      }
      out5 += `
---
Total releases in changelog: ${matches.length}
`;
      return text(out5);
    }
    case "haiku_repair": {
      const repairIntentArg = args2.intent;
      const repairAutoApply = args2.apply !== false;
      const repairSkipBranches = args2.skip_branches === true;
      if (isGitRepo() && !repairIntentArg && !repairSkipBranches) {
        try {
          const { summaries, mainline, archivedSummary } = repairAllBranches(repairAutoApply);
          if (summaries.length > 0 || archivedSummary) {
            return text(
              buildMultiBranchReport(summaries, mainline, archivedSummary)
            );
          }
        } catch (err) {
          return text(
            `Multi-branch repair failed: ${err instanceof Error ? err.message : String(err)}`
          );
        }
      }
      try {
        findHaikuRoot();
      } catch {
        return text("No .haiku/ directory found.");
      }
      let cwdResult;
      try {
        cwdResult = repairCwd(void 0, repairIntentArg, repairAutoApply);
      } catch (err) {
        return text(
          `Repair failed: ${err instanceof Error ? err.message : String(err)}`
        );
      }
      if (repairIntentArg && cwdResult.scanned === 0) {
        return text(`Intent '${repairIntentArg}' not found.`);
      }
      if (cwdResult.scanned === 0) return text("No intents found.");
      return text(buildRepairReport(cwdResult));
    }
    case "haiku_version_info": {
      const info = {
        mcp_version: MCP_VERSION,
        plugin_version: getPluginVersion()
      };
      const pending = getPendingVersion();
      if (pending) info.pending_update = pending;
      if (hasPendingUpdate())
        info.update_note = "A new version has been downloaded and will activate on the next tool call.";
      return text(JSON.stringify(info, null, 2));
    }
    default:
      return text(`Unknown tool: ${name}`);
  }
}
