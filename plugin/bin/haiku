    out4("");
  }
  out4("---");
  out4("");
  out4("## H\xB7AI\xB7K\xB7U Workflow Rules");
  out4("");
  const repoRoot = getRepoRootFromWorktree();
  if (contextScope !== "review") {
    out4("### Branch References");
    out4("");
    out4(`- **Intent branch:** \`haiku/${intentSlug}/main\``);
    out4(
      `- **Intent worktree:** \`${repoRoot}/.haiku/worktrees/${intentSlug}/\``
    );
    out4("");
