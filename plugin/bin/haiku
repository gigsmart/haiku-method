  "../../node_modules/@sentry/core/build/esm/tracing/langchain/utils.js"() {
    init_semanticAttributes();
    init_gen_ai_attributes();
    init_mediaStripping();
    init_messageTruncation();
    init_utils5();
    init_constants6();
    setIfDefined = (target, key, value) => {
      if (value != null) target[key] = value;
    };
    setNumberIfDefined = (target, key, value) => {
      const n = Number(value);
      if (!Number.isNaN(n)) target[key] = n;
    };
  }
});

