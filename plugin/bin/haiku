function normalizeDates(data) {
  const result = { ...data };
  for (const key in result) {
    if (result[key] instanceof Date) {
      result[key] = result[key].toISOString().split("T")[0];
    }
  }
  return result;
}
function parseFrontmatter(raw) {
  const { data, content } = (0, import_gray_matter2.default)(raw);
  return {
    data: normalizeDates(data),
    body: content.trim()
  };
}
function listVisibleIntents(intentsDir, opts) {
  if (!existsSync8(intentsDir)) return [];
  const includeArchived = opts?.includeArchived === true;
  const results = [];
  for (const d of readdirSync3(intentsDir)) {
    const intentFile = join15(intentsDir, d, "intent.md");
    if (!existsSync8(intentFile)) continue;
    const { data } = parseFrontmatter(readFileSync7(intentFile, "utf8"));
    if (!includeArchived && data.archived === true) continue;
    results.push({ slug: d, data });
  }
  return results;
}
function setFrontmatterField(filePath, field, value) {
  const raw = readFileSync7(filePath, "utf8");
  const parsed = (0, import_gray_matter2.default)(raw);
  const updated = { ...parsed.data, [field]: value };
  writeFileSync3(
    filePath,
    import_gray_matter2.default.stringify(
      parsed.content,
      normalizeDates(updated)
    )
  );
}
function parseYaml(raw) {
  const { data } = (0, import_gray_matter2.default)(`---
${raw}
---
`);
  return normalizeDates(data);
}
function getNestedField(obj, path) {
  const parts = path.split(".");
  let current = obj;
  for (const part of parts) {
    if (current == null || typeof current !== "object") return void 0;
    current = current[part];
  }
  return current;
}
function readJson(path) {
  if (!existsSync8(path)) return {};
  return JSON.parse(readFileSync7(path, "utf8"));
}
function writeJson(path, data) {
  mkdirSync4(join15(path, ".."), { recursive: true });
  writeFileSync3(path, `${JSON.stringify(data, null, 2)}
`);
}
function timestamp() {
  return (/* @__PURE__ */ new Date()).toISOString().replace(/\.\d{3}Z$/, "Z");
}
function gitCommitState(message) {
  if (!isGitRepo()) return { committed: false, pushed: false };
  try {
    const haikuRoot = findHaikuRoot();
    execFileSync2("git", ["add", haikuRoot], { encoding: "utf8", stdio: "pipe" });
    execFileSync2("git", ["commit", "-m", message, "--allow-empty"], {
      encoding: "utf8",
      stdio: "pipe"
    });
    try {
      execFileSync2("git", ["push"], { encoding: "utf8", stdio: "pipe" });
      return { committed: true, pushed: true };
    } catch (pushErr) {
      const pushError = pushErr instanceof Error ? pushErr.message : String(pushErr);
      return { committed: true, pushed: false, pushError };
    }
  } catch {
    return { committed: false, pushed: false };
  }
}
function validateBranch(intent, expectedType, unit) {
  if (!isGitRepo()) return "";
  const current = getCurrentBranch();
  if (!current) return "";
  const intentPrefix = `haiku/${intent}/`;
  if (expectedType === "intent") {
    if (!current.startsWith(intentPrefix)) {
      return `\u26A0\uFE0F WRONG BRANCH: Expected a branch under '${intentPrefix}' but on '${current}'. Run \`git checkout haiku/${intent}/main\` or the appropriate stage branch. Custom branch names break the H\xB7AI\xB7K\xB7U lifecycle.`;
    }
  } else if (expectedType === "unit" && unit) {
    const expectedUnit = `haiku/${intent}/${unit}`;
    if (current !== expectedUnit && !current.startsWith(intentPrefix)) {
      return `\u26A0\uFE0F WRONG BRANCH: Expected '${expectedUnit}' or a branch under '${intentPrefix}' but on '${current}'. Ensure you're working in the correct worktree.`;
    }
  }
  return "";
}
function pushWarning(result) {
  if (result.pushed || !result.committed) return "";
  return `

\u26A0\uFE0F GIT PUSH FAILED: ${result.pushError || "unknown error"}. Run \`git pull --rebase && git push\` to sync with remote. If there are conflicts, resolve them then push again.`;
}
function injectPushWarning(obj, result) {
  if (result.pushed || !result.committed) return obj;
  return {
    ...obj,
    push_failed: true,
    push_error: result.pushError || "unknown error",
    message: `${obj.message || ""}. \u26A0\uFE0F GIT PUSH FAILED: ${result.pushError || "unknown error"}. Run \`git pull --rebase && git push\` to resolve.`
  };
}
function setRunNextHandler(handler) {
  _runNext = handler;
}
function resolveActiveStage(intent) {
  const root2 = findHaikuRoot();
  const intentFile = join15(root2, "intents", intent, "intent.md");
  if (!existsSync8(intentFile)) return "";
  const { data } = parseFrontmatter(readFileSync7(intentFile, "utf8"));
  return data.active_stage || "";
}
function findUnitFile(intent, unit) {
  const root2 = findHaikuRoot();
  const activeStage = resolveActiveStage(intent);
  if (activeStage) {
    const p = unitPath(intent, activeStage, unit);
    if (existsSync8(p)) return { path: p, stage: activeStage };
  }
  const stagesDir = join15(root2, "intents", intent, "stages");
  if (!existsSync8(stagesDir)) return null;
  for (const stage of readdirSync3(stagesDir)) {
    const p = unitPath(intent, stage, unit);
    if (existsSync8(p)) return { path: p, stage };
  }
  return null;
}
function resolveStageHats(intent, stage) {
  try {
    const root2 = findHaikuRoot();
    const intentFile = join15(root2, "intents", intent, "intent.md");
    if (!existsSync8(intentFile)) return [];
    const { data } = parseFrontmatter(readFileSync7(intentFile, "utf8"));
    const studio = data.studio || "";
    if (!studio) return [];
    const pluginRoot = resolvePluginRoot();
    for (const base of [
      join15(process.cwd(), ".haiku", "studios"),
      join15(pluginRoot, "studios")
    ]) {
      const stageFile = join15(base, studio, "stages", stage, "STAGE.md");
      if (!existsSync8(stageFile)) continue;
      const { data: stageFm } = parseFrontmatter(
        readFileSync7(stageFile, "utf8")
      );
      return stageFm.hats || [];
    }
  } catch {
  }
  return [];
}
function resolveStageScope(intent, stage) {
  try {
    const root2 = findHaikuRoot();
    const intentFile = join15(root2, "intents", intent, "intent.md");
    if (!existsSync8(intentFile)) return "";
    const { data } = parseFrontmatter(readFileSync7(intentFile, "utf8"));
    const studio = data.studio || "";
    if (!studio) return "";
    const pluginRoot = resolvePluginRoot();
    for (const base of [
      join15(process.cwd(), ".haiku", "studios"),
      join15(pluginRoot, "studios")
    ]) {
      const stageFile = join15(base, studio, "stages", stage, "STAGE.md");
      if (!existsSync8(stageFile)) continue;
      const raw = readFileSync7(stageFile, "utf8");
      const fm = parseFrontmatter(raw);
      const { content } = (0, import_gray_matter2.default)(raw);
      const desc = fm.data.description || stage;
      return `[stage_scope] ${stage}: ${desc} | ${content.trim().slice(0, 500)}`;
    }
  } catch {
  }
  return "";
}
function syncSessionMetadata(intent, stateFile) {
  if (!stateFile) return;
  try {
    const root2 = findHaikuRoot();
    const intentFile = join15(root2, "intents", intent, "intent.md");
    if (!existsSync8(intentFile)) return;
    const { data: intentData } = parseFrontmatter(
      readFileSync7(intentFile, "utf8")
    );
    const studio = intentData.studio || "";
    const activeStage = intentData.active_stage || "";
    let phase = "";
    if (activeStage) {
      const sf = stageStatePath(intent, activeStage);
      const stageState = readJson(sf);
      phase = stageState.phase || "";
    }
    let activeUnit = null;
    let hat = null;
    let bolt = null;
    if (activeStage) {
      const unitsDir = join15(stageDir(intent, activeStage), "units");
      if (existsSync8(unitsDir)) {
        for (const f of readdirSync3(unitsDir).filter(
          (f2) => f2.endsWith(".md")
        )) {
          const { data: unitData } = parseFrontmatter(
            readFileSync7(join15(unitsDir, f), "utf8")
          );
          if (unitData.status === "active") {
            activeUnit = f.replace(".md", "");
            hat = unitData.hat || null;
            bolt = unitData.bolt || null;
            break;
          }
        }
      }
    }
    let stageDescription = activeStage;
    if (studio && activeStage) {
      const pluginRoot = resolvePluginRoot();
      for (const base of [
        join15(process.cwd(), ".haiku", "studios"),
        join15(pluginRoot, "studios")
      ]) {
        const sf = join15(base, studio, "stages", activeStage, "STAGE.md");
        if (!existsSync8(sf)) continue;
        const { data: stageFm } = parseFrontmatter(readFileSync7(sf, "utf8"));
        stageDescription = stageFm.description || activeStage;
        break;
      }
    }
    writeHaikuMetadata(stateFile, {
      intent,
      studio,
      active_stage: activeStage,
      phase,
      active_unit: activeUnit,
      hat,
      bolt,
      stage_description: stageDescription,
      updated_at: (/* @__PURE__ */ new Date()).toISOString().replace(/\.\d{3}Z$/, "Z")
    });
  } catch {
  }
}
function handleStateTool(name, args2) {
  const text = (s) => ({
    content: [{ type: "text", text: s }]
  });
  const validationError = validateSlugArgs(args2);
  if (validationError) return validationError;
  switch (name) {
    // ── Intent ──
    case "haiku_intent_get": {
      const file = join15(intentDir2(args2.slug), "intent.md");
      if (!existsSync8(file)) return text("");
      const { data } = parseFrontmatter(readFileSync7(file, "utf8"));
      const val = data[args2.field];
      return text(
        val == null ? "" : typeof val === "object" ? JSON.stringify(val) : String(val)
      );
    }
    case "haiku_intent_list": {
      const root2 = findHaikuRoot();
      const intentsDir = join15(root2, "intents");
      if (!existsSync8(intentsDir)) return text("[]");
      const includeArchived = args2.include_archived === true;
      const entries = listVisibleIntents(intentsDir, { includeArchived });
      const intents = entries.map(({ slug, data }) => {
        const base = {
          slug,
          studio: data.studio,
          status: data.status,
          active_stage: data.active_stage
        };
        if (includeArchived) {
          base.archived = data.archived === true;
        }
        return base;
      });
      return text(JSON.stringify(intents, null, 2));
    }
    // ── Stage ──
    case "haiku_stage_get": {
      const path = stageStatePath(args2.intent, args2.stage);
      const data = readJson(path);
      const val = data[args2.field];
      return text(val == null ? "" : String(val));
    }
    // ── Unit ──
    case "haiku_unit_get": {
      const path = unitPath(
        args2.intent,
        args2.stage,
        args2.unit
      );
      if (!existsSync8(path)) return text("");
      const { data } = parseFrontmatter(readFileSync7(path, "utf8"));
      const val = data[args2.field];
      return text(
        val == null ? "" : typeof val === "object" ? JSON.stringify(val) : String(val)
      );
    }
    case "haiku_unit_set": {
      const fsmProtectedFields = new Set(UNIT_FIELDS);
      const field = args2.field;
      if (!getCapabilities().hooks && fsmProtectedFields.has(field)) {
        return text(
          JSON.stringify({
            error: "fsm_field_protected",
            field,
            message: `Cannot set '${field}' directly \u2014 it is controlled by the FSM. Use haiku_run_next, haiku_unit_start, haiku_unit_advance_hat, or haiku_unit_reject_hat instead.`
          })
        );
      }
      const path = unitPath(
        args2.intent,
        args2.stage,
        args2.unit
      );
      setFrontmatterField(path, args2.field, args2.value);
      return text("ok");
    }
    case "haiku_unit_list": {
      const dir = join15(
        stageDir(args2.intent, args2.stage),
        "units"
      );
      if (!existsSync8(dir)) return text("[]");
      const files = readdirSync3(dir).filter((f) => f.endsWith(".md"));
      const units = files.map((f) => {
        const { data } = parseFrontmatter(readFileSync7(join15(dir, f), "utf8"));
        return {
          name: f.replace(".md", ""),
          status: data.status,
          bolt: data.bolt,
          hat: data.hat,
          model: data.model ?? null
        };
      });
      return text(JSON.stringify(units, null, 2));
    }
    case "haiku_unit_start": {
      const stage = resolveActiveStage(args2.intent);
      if (!stage)
        return text(
          JSON.stringify({
            error: "no_active_stage",
            message: "No active stage found for this intent. Call haiku_run_next first."
          })
        );
      const uPath = unitPath(args2.intent, stage, args2.unit);
      if (existsSync8(uPath)) {
        const { data: existingFm } = parseFrontmatter(
          readFileSync7(uPath, "utf8")
        );
        if (existingFm.status === "active") {
          const scope2 = resolveStageScope(args2.intent, stage);
          return text(
            JSON.stringify({
              error: "unit_already_active",
              unit: args2.unit,
              hat: existingFm.hat || "",
              message: `Unit '${args2.unit}' is already active (hat: ${existingFm.hat || "unknown"}). Do not start it again \u2014 continue working on it or call haiku_unit_advance_hat when done.`
            }) + (scope2 ? `

${scope2}` : "")
          );
        }
      }
      const stageHats = resolveStageHats(args2.intent, stage);
      const firstHat = stageHats[0] || "";
      setFrontmatterField(uPath, "status", "active");
      setFrontmatterField(uPath, "bolt", 1);
      setFrontmatterField(uPath, "hat", firstHat);
      setFrontmatterField(uPath, "started_at", timestamp());
      setFrontmatterField(uPath, "hat_started_at", timestamp());
      sealIntentState(args2.intent);
      emitTelemetry("haiku.unit.started", {
        intent: args2.intent,
        stage,
        unit: args2.unit,
        hat: firstHat
      });
      const sf = args2.state_file;
      if (sf)
        logSessionEvent(sf, {
          event: "unit_started",
          intent: args2.intent,
          stage,
          unit: args2.unit,
          hat: firstHat
        });
      const gitResult = gitCommitState(
        `haiku: start unit ${args2.unit}`
      );
      syncSessionMetadata(
        args2.intent,
        args2.state_file
      );
      const scope = resolveStageScope(args2.intent, stage);
      return text((scope ? `ok

${scope}` : "ok") + pushWarning(gitResult));
    }
    case "haiku_unit_advance_hat": {
      const unitInfo = findUnitFile(args2.intent, args2.unit);
      if (!unitInfo)
        return text(
          JSON.stringify({
            error: "unit_not_found",
            message: `Unit '${args2.unit}' not found in any stage of intent '${args2.intent}'.`
          })
        );
      const advPath = unitInfo.path;
      const advStage = unitInfo.stage;
      const unitRaw = readFileSync7(advPath, "utf8");
      const { data: unitFm } = parseFrontmatter(unitRaw);
      if (unitFm.status === "completed") {
        return text(
          JSON.stringify({
            error: "unit_already_completed",
            unit: args2.unit,
            message: `Unit '${args2.unit}' is already completed. Cannot advance hat on a completed unit.`
          })
        );
      }
      const currentHat = unitFm.hat || "";
      const hatStartedAt = unitFm.hat_started_at;
      if (hatStartedAt) {
        const elapsed = (Date.now() - new Date(hatStartedAt).getTime()) / 1e3;
        if (elapsed < 30) {
          return text(
            JSON.stringify({
              error: "hat_too_fast",
              elapsed_seconds: Math.round(elapsed),
              minimum_seconds: 30,
              message: "Cannot advance hat \u2014 the current hat started less than 30 seconds ago. Each hat must do meaningful work before advancing."
            })
          );
        }
      }
      const unitOutputs = unitFm.outputs || [];
      if (unitOutputs.length > 0) {
        const iDir = intentDir2(args2.intent);
        const escaped = unitOutputs.filter((o) => {
          const resolved = resolve3(iDir, o);
          return !resolved.startsWith(`${resolve3(iDir)}/`);
        });
        if (escaped.length > 0) {
          return text(
            JSON.stringify({
              error: "unit_outputs_escaped",
              escaped,
              message: `Cannot advance hat: ${escaped.length} output path(s) escape the intent directory: ${escaped.join(", ")}. Fix the outputs in the unit frontmatter.`
            })
          );
        }
        const missing = unitOutputs.filter((o) => {
          const resolved = resolve3(iDir, o);
          if (!resolved.startsWith(`${resolve3(iDir)}/`)) return false;
          return !existsSync8(resolved);
        });
        if (missing.length > 0) {
          const sf = args2.state_file;
          if (sf)
            logSessionEvent(sf, {
              event: "outputs_missing",
              intent: args2.intent,
              stage: advStage,
              unit: args2.unit,
              missing
            });
          return text(
            JSON.stringify({
              error: "unit_outputs_missing",
              missing,
              message: `Cannot advance hat: ${missing.length} declared output(s) not found: ${missing.join(", ")}. Create them or remove them from the outputs list.`
            })
          );
        }
      }
      const stageHats = resolveStageHats(args2.intent, advStage);
      const currentIdx = stageHats.indexOf(currentHat);
      const nextIdx = currentIdx + 1;
      const isLastHat = nextIdx >= stageHats.length;
      if (isLastHat) {
        if (!getCapabilities().hooks) {
          const qualityGates = runInlineQualityGates(
            args2.intent,
            advPath
          );
          if (qualityGates) {
            return text(JSON.stringify(qualityGates));
          }
        }
        if (unitOutputs.length === 0) {
          const sf = args2.state_file;
          if (sf)
            logSessionEvent(sf, {
              event: "outputs_empty",
              intent: args2.intent,
              stage: advStage,
              unit: args2.unit
            });
          return text(
            JSON.stringify({
              error: "unit_outputs_empty",
              message: "Cannot complete unit: no outputs were produced. Every unit must write at least one artifact under the intent directory \u2014 either a stage artifact (stages/<stage>/... excluding units/ and state.json) or a knowledge document (knowledge/...). The track-outputs hook auto-populates `outputs:` as files are written; if your work is done but nothing was tracked, add the produced paths manually to the unit's `outputs:` frontmatter field."
            })
          );
        }
        const unchecked = (unitRaw.match(/- \[ \]/g) || []).length;
        if (unchecked > 0) {
          const sf = args2.state_file;
          if (sf)
            logSessionEvent(sf, {
              event: "criteria_not_met",
              intent: args2.intent,
              stage: advStage,
              unit: args2.unit,
              unchecked
            });
          return text(
            JSON.stringify({
              error: "criteria_not_met",
              unchecked,
              message: `Cannot complete unit: ${unchecked} completion criteria still unchecked. Address them, then call haiku_unit_advance_hat again.`
            })
          );
        }
        setFrontmatterField(advPath, "status", "completed");
        setFrontmatterField(advPath, "completed_at", timestamp());
        sealIntentState(args2.intent);
        emitTelemetry("haiku.unit.completed", {
          intent: args2.intent,
          stage: advStage,
          unit: args2.unit
        });
        {
          const sf = args2.state_file;
          if (sf)
            logSessionEvent(sf, {
              event: "unit_completed",
              intent: args2.intent,
              stage: advStage,
              unit: args2.unit
            });
        }
        const completeGit = gitCommitState(
          `haiku: complete unit ${args2.unit}`
        );
        const intentSlug = args2.intent;
        const currentBr = getCurrentBranch();
        const onStageBranch = currentBr === `haiku/${intentSlug}/${advStage}`;
        const discreteStage = onStageBranch ? advStage : void 0;
        const parentBranchName = discreteStage ? `haiku/${intentSlug}/${discreteStage}` : `haiku/${intentSlug}/main`;
        const mergeResult = mergeUnitWorktree(
          intentSlug,
          args2.unit,
          discreteStage
        );
        if (!mergeResult.success) {
          const worktreePath = join15(
            process.cwd(),
            ".haiku",
            "worktrees",
            intentSlug,
            args2.unit
          );
          return text(
            JSON.stringify(
              {
                action: "merge_conflict",
                status: "completed_merge_failed",
                intent: args2.intent,
                unit: args2.unit,
                worktree: worktreePath,
                error: mergeResult.message,
                message: `Unit completed but merge to parent branch failed: ${mergeResult.message}. RESOLVE: cd to the parent branch (\`git checkout ${parentBranchName}\`), merge manually (\`git merge haiku/${intentSlug}/${args2.unit} --no-edit\`), resolve any conflicts, then commit and push. If you cannot resolve, ask the user for help.`
              },
              null,
              2
            )
          );
        }
        syncSessionMetadata(
          args2.intent,
          args2.state_file
        );
        const mergeNote = mergeResult.message === "no worktree" ? "" : ` (${mergeResult.message})`;
        if (_runNext) {
          const next = _runNext(args2.intent);
          if (next.action === "continue_unit" || next.action === "blocked") {
            return text(
              `completed (last hat)${mergeNote}. Other units still in progress \u2014 waiting on wave to finish.${pushWarning(completeGit)}`
            );
          }
          return text(
            JSON.stringify(
              injectPushWarning(
                { ...next, _unit_completed: args2.unit, _merge: mergeNote },
                completeGit
              ),
              null,
              2
            )
          );
        }
        return text(
          `completed (last hat)${mergeNote}${pushWarning(completeGit)}`
        );
      }
      const nextHat = stageHats[nextIdx];
      setFrontmatterField(advPath, "hat", nextHat);
      setFrontmatterField(advPath, "hat_started_at", timestamp());
      sealIntentState(args2.intent);
      {
        const sf = args2.state_file;
        if (sf)
          logSessionEvent(sf, {
            event: "hat_advanced",
            intent: args2.intent,
            stage: advStage,
            unit: args2.unit,
            hat: nextHat
          });
      }
      emitTelemetry("haiku.hat.transition", {
        intent: args2.intent,
        stage: advStage,
        unit: args2.unit,
        hat: nextHat
      });
      const advGit = gitCommitState(
        `haiku: advance hat to ${nextHat} on ${args2.unit}`
      );
      syncSessionMetadata(
        args2.intent,
        args2.state_file
      );
      if (_runNext) {
        const next = _runNext(args2.intent);
        return text(
          JSON.stringify(
            injectPushWarning({ ...next, _hat_advanced: nextHat }, advGit),
            null,
            2
          )
        );
      }
      const hatScope = resolveStageScope(args2.intent, advStage);
      return text(
        (hatScope ? `advanced to ${nextHat}

${hatScope}` : `advanced to ${nextHat}`) + pushWarning(advGit)
      );
    }
    case "haiku_unit_reject_hat": {
      const rejectInfo = findUnitFile(
        args2.intent,
        args2.unit
      );
      if (!rejectInfo)
        return text(
          JSON.stringify({
            error: "unit_not_found",
            message: `Unit '${args2.unit}' not found in any stage of intent '${args2.intent}'.`
          })
        );
      const failPath = rejectInfo.path;
      const rejectStage = rejectInfo.stage;
      const { data: failData } = parseFrontmatter(
        readFileSync7(failPath, "utf8")
      );
      const currentHat = failData.hat || "";
      const currentBolt = failData.bolt || 1;
      const MAX_BOLTS_FAIL = 5;
      if (currentBolt + 1 > MAX_BOLTS_FAIL) {
        return text(
          JSON.stringify({
            error: "max_bolts_exceeded",
            bolt: currentBolt,
            max: MAX_BOLTS_FAIL,
            message: `Unit has exceeded ${MAX_BOLTS_FAIL} bolt iterations. Escalate to the user \u2014 this unit may need to be redesigned or split.`
          })
        );
      }
      const stageHats = resolveStageHats(args2.intent, rejectStage);
      const hatIdx = stageHats.indexOf(currentHat);
      const prevHat = hatIdx > 0 ? stageHats[hatIdx - 1] : stageHats[0];
      if (features.modelSelection) {
        const currentModel = failData.model;
        const escalated = escalate(currentModel);
        if (currentModel && escalated) {
          setFrontmatterField(failPath, "model_original", currentModel);
          setFrontmatterField(failPath, "model", escalated);
          console.error(
            `[haiku] model escalated: ${currentModel} \u2192 ${escalated} (hat rejected, bolt ${currentBolt + 1})`
          );
        }
      }
      setFrontmatterField(failPath, "hat", prevHat);
      setFrontmatterField(failPath, "bolt", currentBolt + 1);
      setFrontmatterField(failPath, "hat_started_at", timestamp());
      sealIntentState(args2.intent);
      {
        const sf = args2.state_file;
        if (sf)
          logSessionEvent(sf, {
            event: "unit_failed",
            intent: args2.intent,
            stage: rejectStage,
            unit: args2.unit,
            from_hat: currentHat,
            to_hat: prevHat,
            bolt: currentBolt + 1
          });
      }
      emitTelemetry("haiku.unit.failed", {
        intent: args2.intent,
        stage: rejectStage,
        unit: args2.unit,
        hat: currentHat,
        prev_hat: prevHat,
        bolt: String(currentBolt + 1)
      });
      const rejectGit = gitCommitState(
        `haiku: fail ${args2.unit} \u2014 back to ${prevHat}, bolt ${currentBolt + 1}`
      );
      syncSessionMetadata(
        args2.intent,
        args2.state_file
      );
      return text(
        `rejected \u2014 back to ${prevHat}, bolt ${currentBolt + 1}${pushWarning(rejectGit)}`
      );
    }
    case "haiku_unit_increment_bolt": {
      const path = unitPath(
        args2.intent,
        args2.stage,
        args2.unit
      );
      const { data } = parseFrontmatter(readFileSync7(path, "utf8"));
      const current = data.bolt || 0;
