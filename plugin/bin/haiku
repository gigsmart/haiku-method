function readStageArtifactDefs(studio, stage) {
  validateIdentifier(studio, "studio");
  validateIdentifier(stage, "stage");
  const defs = [];
  const seen = /* @__PURE__ */ new Set();
  for (const base of [...studioSearchPaths2()].reverse()) {
    for (const kind of ["discovery", "outputs"]) {
      const artifactDir = join13(base, studio, "stages", stage, kind);
      if (!existsSync7(artifactDir)) continue;
      for (const f of readdirSync2(artifactDir).filter(
        (f2) => f2.endsWith(".md")
      )) {
        const key = `${kind}:${f}`;
        if (seen.has(key)) continue;
        seen.add(key);
        const raw = readFileSync5(join13(artifactDir, f), "utf8");
        const { data, body } = parseFrontmatter(raw);
        defs.push({
          name: data.name || f.replace(/\.md$/, ""),
          location: data.location || "",
          scope: data.scope || "intent",
          format: data.format || "text",
          required: data.required !== false,
          body,
          kind: kind === "outputs" ? "output" : "discovery"
        });
      }
    }
  }
  return defs;
}
function resolveStageInputs(studio, inputs, intentDir3, intentSlug) {
  const resolved = [];
  for (const input of inputs) {
    const stageName = input.stage;
    const artifactDefs = readStageArtifactDefs(studio, stageName);
    if (input.discovery) {
      const def = artifactDefs.find(
        (d) => d.name === input.discovery && d.kind === "discovery"
      );
      if (def?.location) {
        const absPath = resolveArtifactPath(def.location, intentDir3, intentSlug);
        const exists = existsSync7(absPath);
        const isDir = def.location.endsWith("/") || exists && statSync(absPath).isDirectory();
        if (isDir && exists) {
          const contents = readDirFilesRecursive(absPath);
          resolved.push({
            stage: stageName,
            artifactName: input.discovery,
            kind: "discovery",
            resolvedPath: absPath,
            exists,
            content: contents || "(empty directory)",
            description: def.body
          });
        } else {
          resolved.push({
            stage: stageName,
            artifactName: input.discovery,
            kind: "discovery",
            resolvedPath: absPath,
            exists,
            content: exists ? readFileSync5(absPath, "utf8") : null,
            description: def.body
          });
        }
      }
    }
    if (input.output) {
      const def = artifactDefs.find(
        (d) => d.name === input.output && d.kind === "output"
      );
      if (def?.location) {
        const absPath = resolveArtifactPath(def.location, intentDir3, intentSlug);
        const exists = existsSync7(absPath);
        const isDir = def.location.endsWith("/") || exists && statSync(absPath).isDirectory();
        if (isDir && exists) {
          const contents = readDirFilesRecursive(absPath);
          resolved.push({
            stage: stageName,
            artifactName: input.output,
            kind: "output",
            resolvedPath: absPath,
            exists,
            content: contents || "(empty directory)",
            description: def.body
          });
        } else {
          resolved.push({
            stage: stageName,
            artifactName: input.output,
            kind: "output",
            resolvedPath: absPath,
            exists,
            content: exists ? readFileSync5(absPath, "utf8") : null,
            description: def.body
          });
        }
      }
    }
  }
  return resolved;
}
function readDirFilesRecursive(dir, prefix = "") {
  const entries = readdirSync2(dir).filter((f) => !f.startsWith("."));
  const sections = [];
  for (const entry of entries) {
    const fullPath = join13(dir, entry);
    const relPath = prefix ? `${prefix}/${entry}` : entry;
    let stat;
    try {
      stat = lstatSync(fullPath);
    } catch {
      continue;
    }
    if (stat.isSymbolicLink()) {
      continue;
    }
    if (stat.isDirectory()) {
      sections.push(readDirFilesRecursive(fullPath, relPath));
    } else {
      let content;
      try {
        content = readFileSync5(fullPath, "utf8");
      } catch {
        continue;
      }
      sections.push(
        `### ${relPath}

${content.slice(0, 1500)}${content.length > 1500 ? "\n...(truncated)" : ""}`
      );
    }
  }
  return sections.filter(Boolean).join("\n\n");
}
function resolveArtifactPath(locationTemplate, intentDir3, intentSlug) {
  const relativePath = locationTemplate.replace(/^\.haiku\/intents\/\{intent-slug\}\//, "").replace(/\{intent-slug\}/g, intentSlug);
  return join13(intentDir3, relativePath);
}
function scanStudiosFromDisk() {
  const seen = /* @__PURE__ */ new Map();
  const pluginRoot = resolvePluginRoot();
  const paths = studioSearchPaths2();
  for (const base of [...paths].reverse()) {
    if (!existsSync7(base)) continue;
    const source = pluginRoot && base.startsWith(pluginRoot) ? "plugin" : "project";
    for (const d of readdirSync2(base, { withFileTypes: true })) {
      if (!d.isDirectory()) continue;
      const studioPath = join13(base, d.name);
      const file = join13(studioPath, "STUDIO.md");
      if (!existsSync7(file)) continue;
      const { data, body } = parseFrontmatter(readFileSync5(file, "utf8"));
      const name = data.name || d.name;
      const slug = data.slug || name;
      const aliases = Array.isArray(data.aliases) ? data.aliases : [];
      seen.set(d.name, {
        dir: d.name,
        name,
        slug,
        aliases,
        description: data.description || "",
        category: data.category || "general",
        stages: Array.isArray(data.stages) ? data.stages : [],
        data,
        body,
        source,
        path: studioPath,
        studioFile: file
      });
    }
  }
  return Array.from(seen.values());
}
function listStudios() {
  const key = studioSearchPaths2().join("|");
  const now = Date.now();
  if (listStudiosCache && listStudiosCache.key === key && listStudiosCache.expiresAt > now) {
    return listStudiosCache.value;
  }
  const value = scanStudiosFromDisk();
  listStudiosCache = { key, expiresAt: now + LIST_STUDIOS_TTL_MS, value };
  return value;
}
function resolveStudio(identifier) {
  if (!identifier) return null;
  const needle = identifier.toLowerCase();
  const all = listStudios();
  for (const s of all) {
    if (s.dir.toLowerCase() === needle) return s;
    if (s.name.toLowerCase() === needle) return s;
    if (s.slug.toLowerCase() === needle) return s;
    if (s.aliases.some((a) => a.toLowerCase() === needle)) return s;
  }
  return null;
}
