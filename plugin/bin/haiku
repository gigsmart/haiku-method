function extractModel(params, context2) {
  if ("model" in params && typeof params.model === "string") {
    return params.model;
  }
  if (context2 && typeof context2 === "object") {
    const contextObj = context2;
    if ("model" in contextObj && typeof contextObj.model === "string") {
      return contextObj.model;
    }
    if ("modelVersion" in contextObj && typeof contextObj.modelVersion === "string") {
      return contextObj.modelVersion;
    }
  }
  return "unknown";
}
function extractConfigAttributes(config5) {
  const attributes = {};
  if ("temperature" in config5 && typeof config5.temperature === "number") {
    attributes[GEN_AI_REQUEST_TEMPERATURE_ATTRIBUTE] = config5.temperature;
  }
  if ("topP" in config5 && typeof config5.topP === "number") {
    attributes[GEN_AI_REQUEST_TOP_P_ATTRIBUTE] = config5.topP;
  }
  if ("topK" in config5 && typeof config5.topK === "number") {
    attributes[GEN_AI_REQUEST_TOP_K_ATTRIBUTE] = config5.topK;
  }
  if ("maxOutputTokens" in config5 && typeof config5.maxOutputTokens === "number") {
    attributes[GEN_AI_REQUEST_MAX_TOKENS_ATTRIBUTE] = config5.maxOutputTokens;
  }
  if ("frequencyPenalty" in config5 && typeof config5.frequencyPenalty === "number") {
    attributes[GEN_AI_REQUEST_FREQUENCY_PENALTY_ATTRIBUTE] = config5.frequencyPenalty;
  }
  if ("presencePenalty" in config5 && typeof config5.presencePenalty === "number") {
    attributes[GEN_AI_REQUEST_PRESENCE_PENALTY_ATTRIBUTE] = config5.presencePenalty;
  }
  return attributes;
}
function extractRequestAttributes3(operationName, params, context2) {
  const attributes = {
    [GEN_AI_SYSTEM_ATTRIBUTE]: GOOGLE_GENAI_SYSTEM_NAME,
    [GEN_AI_OPERATION_NAME_ATTRIBUTE]: operationName,
    [SEMANTIC_ATTRIBUTE_SENTRY_ORIGIN]: "auto.ai.google_genai"
  };
  if (params) {
    attributes[GEN_AI_REQUEST_MODEL_ATTRIBUTE] = extractModel(params, context2);
    if ("config" in params && typeof params.config === "object" && params.config) {
