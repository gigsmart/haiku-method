function logAndExitProcess(error4) {
  consoleSandbox(() => {
    console.error(error4);
  });
  const client = getClient();
  if (client === void 0) {
    DEBUG_BUILD2 && debug.warn("No NodeClient was defined, we are exiting the process now.");
    global.process.exit(1);
    return;
  }
  const options2 = client.getOptions();
  const timeout = options2?.shutdownTimeout && options2.shutdownTimeout > 0 ? options2.shutdownTimeout : DEFAULT_SHUTDOWN_TIMEOUT;
  client.close(timeout).then(
    (result) => {
      if (!result) {
        DEBUG_BUILD2 && debug.warn("We reached the timeout for emptying the request buffer, still exiting now!");
      }
      global.process.exit(1);
    },
    (error5) => {
      DEBUG_BUILD2 && debug.error(error5);
    }
  );
}
