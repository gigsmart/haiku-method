      (f) => f.endsWith(".md")
    );
    const missing = [];
    for (const f of discoveryDefs) {
      const raw = readFileSync10(join18(discoveryDir, f), "utf8");
      const { data } = (0, import_gray_matter4.default)(raw);
      const required3 = data.required !== false;
      if (!required3) continue;
      const location = data.location || "";
      if (!location) continue;
      if (location.startsWith("(")) continue;
      const resolved = location.replace("{intent-slug}", slug);
      const absPath = join18(process.cwd(), resolved);
      if (resolved.endsWith("/")) {
        if (!existsSync11(absPath) || readdirSync6(absPath).filter((e) => e !== ".gitkeep").length === 0) {
