  "../../node_modules/@sentry/core/build/esm/tracing/langchain/constants.js"() {
    LANGCHAIN_INTEGRATION_NAME = "LangChain";
    LANGCHAIN_ORIGIN = "auto.ai.langchain";
    ROLE_MAP = {
      human: "user",
      ai: "assistant",
      assistant: "assistant",
      system: "system",
      function: "function",
