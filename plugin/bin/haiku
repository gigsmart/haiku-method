    "use strict";
    init_types3();
    registry3 = /* @__PURE__ */ new Map();
  }
});

// src/prompts/skill-bridge.ts
import { existsSync as existsSync12, readFileSync as readFileSync11, readdirSync as readdirSync7 } from "node:fs";
import { join as join19 } from "node:path";
function registerSkillPrompts() {
  let count = 0;
  registerPrompt({
    name: "haiku:status",
    title: "H\xB7AI\xB7K\xB7U: Check active work",
    description: "Check for active H\xB7AI\xB7K\xB7U intents and get your current action. Call this at the start of every session to resume in-progress work.",
    arguments: [],
    handler: async () => {
      return {
        description: "Check for active H\xB7AI\xB7K\xB7U work",
        messages: [
          {
            role: "user",
            content: {
              type: "text",
              text: 'Check if there is active H\xB7AI\xB7K\xB7U work in this project.\n\n1. Call `haiku_dashboard` to see all intents and their status\n2. If there is an active intent, call `haiku_run_next { intent: "<slug>" }` to get your current action\n3. If no active intents exist, let me know \u2014 I can start one with `haiku:start`\n\nDo this silently \u2014 just check and report what you find.'
            }
          }
        ]
      };
    }
  });
  count++;
  const pluginRoot = resolvePluginRoot();
  if (!pluginRoot) {
    console.error(
      `[haiku] Registered ${count} prompt(s) (plugin root not found \u2014 skills not bridged)`
    );
    return count;
  }
  const skillsDir = join19(pluginRoot, "skills");
  if (!existsSync12(skillsDir)) {
    console.error(
      `[haiku] Registered ${count} prompt(s) (skills dir not found \u2014 skills not bridged)`
    );
    return count;
  }
  const entries = readdirSync7(skillsDir, { withFileTypes: true });
  for (const entry of entries) {
    if (!entry.isDirectory()) continue;
    const skillFile = join19(skillsDir, entry.name, "SKILL.md");
    if (!existsSync12(skillFile)) continue;
    const raw = readFileSync11(skillFile, "utf8");
    const { data, body } = parseFrontmatter(raw);
    const skillName = data.name || entry.name;
    const skillDesc = data.description || "";
    const promptName = `haiku:${skillName}`;
    registerPrompt({
      name: promptName,
      title: `H\xB7AI\xB7K\xB7U: ${skillName}`,
      description: skillDesc || `Run the H\xB7AI\xB7K\xB7U ${skillName} workflow`,
      arguments: [
        {
          name: "args",
          description: "Optional arguments to pass to the skill (e.g., intent slug, unit name)",
          required: false
        }
      ],
      handler: async (args2) => {
        const userArgs = args2.args || "";
        const content = userArgs ? `${body}

---

**User arguments:** ${userArgs}` : body;
        return {
          description: `H\xB7AI\xB7K\xB7U ${skillName} workflow`,
          messages: [
            {
              role: "user",
              content: {
                type: "text",
                text: content
              }
            }
          ]
        };
      }
    });
    count++;
  }
  if (count > 0) {
    console.error(
      `[haiku] Registered ${count} prompt(s) as MCP prompts (harness lacks native skill support)`
    );
  }
  return count;
}
var init_skill_bridge = __esm({
  "src/prompts/skill-bridge.ts"() {
    "use strict";
    init_config();
    init_state_tools();
    init_prompts();
  }
});

// src/server.ts
var server_exports = {};
import { spawn as spawn3 } from "node:child_process";
import { readFile as readFile4 } from "node:fs/promises";
import { dirname as dirname7, join as join20, resolve as resolve5 } from "node:path";
async function handleToolCall(request2) {
  const { name, arguments: args2 } = request2.params;
  if (name === "haiku_run_next" || name === "haiku_revisit" || name === "haiku_intent_create" || name === "haiku_select_studio" || name === "haiku_intent_reset" || name === "haiku_intent_archive" || name === "haiku_intent_unarchive") {
    return handleOrchestratorTool(name, args2 ?? {});
  }
  if (name === "haiku_feedback") {
    if (!isSentryConfigured()) {
      return {
        content: [
          {
            type: "text",
            text: "Feedback is not available in this installation (Sentry DSN not configured)."
          }
        ]
      };
    }
    const typedArgs = args2 ?? {};
    const message = typedArgs.message;
    if (!message) {
      return {
        content: [
          { type: "text", text: "Error: message is required" }
        ],
        isError: true
      };
    }
    const contactEmail = typedArgs.contact_email;
    const userName = typedArgs.name;
    const sessionCtx = typedArgs._session_context;
    reportFeedback(message, sessionCtx, contactEmail, userName);
    return {
      content: [
        { type: "text", text: "Feedback submitted. Thank you!" }
      ]
    };
  }
  if (name.startsWith("haiku_")) {
    return handleStateTool(name, args2 ?? {});
  }
  if (name === "open_review") {
    return {
      content: [
        {
          type: "text",
          text: "Error: open_review cannot be called directly. Use haiku_run_next to advance \u2014 it validates units and opens the review automatically when ready."
        }
      ],
      isError: true
    };
  }
  if (name === "ask_user_visual_question") {
    const input = AskVisualQuestionInput.parse(args2);
    const title = input.title ?? "Question";
    const context2 = input.context ?? "";
    const questions = input.questions;
    const imagePaths = input.image_paths ?? [];
    const imageBaseDirs = imagePaths.map((p) => dirname7(resolve5(p)));
    const session = createQuestionSession({
      title,
      questions,
      context: context2,
      imagePaths,
      imageBaseDirs,
      html: ""
    });
    const imageUrls = imagePaths.map(
      (_2, i) => `/question-image/${session.session_id}/${i}`
    );
    session.html = renderQuestionPage({
      title,
      questions,
      context: context2,
      sessionId: session.session_id,
      imageUrls
    });
    const port = await startHttpServer();
    let questionUrl;
    if (isRemoteReviewEnabled()) {
      const tunnelUrl = await openTunnel(port);
      questionUrl = buildReviewUrl(session.session_id, tunnelUrl, "question");
    } else {
      questionUrl = `http://127.0.0.1:${port}/question/${session.session_id}`;
    }
    try {
      const cmd2 = process.platform === "darwin" ? ["open", questionUrl] : ["xdg-open", questionUrl];
      spawn3(cmd2[0], cmd2.slice(1), { stdio: "ignore", detached: true }).unref();
    } catch (err) {
      console.error("Failed to open browser:", err);
    }
    const MAX_WAIT_Q = 30 * 60 * 1e3;
    try {
      await waitForSession(session.session_id, MAX_WAIT_Q);
    } catch {
      return {
        content: [
          {
            type: "text",
            text: JSON.stringify(
              {
                status: "timeout",
                url: questionUrl,
                session_id: session.session_id,
                message: "User did not respond within 30 minutes"
              },
              null,
              2
            )
          }
        ]
      };
    }
    const updatedQuestionSession = getSession(session.session_id);
    if (updatedQuestionSession && updatedQuestionSession.session_type === "question" && updatedQuestionSession.status === "answered" && updatedQuestionSession.answers) {
      const questionResult = {
        status: "answered",
        url: questionUrl,
        answers: updatedQuestionSession.answers
      };
      if (updatedQuestionSession.feedback) {
        questionResult.feedback = updatedQuestionSession.feedback;
      }
      if (updatedQuestionSession.annotations?.comments?.length) {
        questionResult.annotations = updatedQuestionSession.annotations;
      }
      return {
        content: [
          {
            type: "text",
            text: JSON.stringify(questionResult, null, 2)
          }
        ]
      };
    }
    return {
      content: [
        {
          type: "text",
          text: JSON.stringify(
            {
              status: "timeout",
              url: questionUrl,
              session_id: session.session_id,
              message: "User did not respond within 30 minutes"
            },
            null,
            2
          )
        }
      ]
    };
  }
  if (name === "pick_design_direction") {
    const input = PickDesignDirectionInput.parse(args2);
    const title = input.title ?? "Design Direction";
    let archetypes;
    if (input.archetypes) {
      archetypes = input.archetypes;
    } else if (input.archetypes_file) {
      const raw = await readFile4(resolve5(input.archetypes_file), "utf-8");
      archetypes = external_exports.array(DesignArchetypeSchema).parse(JSON.parse(raw));
    } else {
      return {
        content: [
          {
            type: "text",
            text: "Error: provide either archetypes or archetypes_file"
          }
        ]
      };
    }
    let parameters;
    if (input.parameters) {
      parameters = input.parameters;
    } else if (input.parameters_file) {
      const raw = await readFile4(resolve5(input.parameters_file), "utf-8");
      parameters = external_exports.array(DesignParameterSchema).parse(JSON.parse(raw));
    } else {
      return {
        content: [
          {
            type: "text",
            text: "Error: provide either parameters or parameters_file"
          }
        ]
      };
    }
    const session = createDesignDirectionSession({
      intent_slug: input.intent_slug,
      archetypes,
      parameters,
      html: ""
    });
    session.html = renderDesignDirectionPage({
      title,
      archetypes,
      parameters,
      sessionId: session.session_id
    });
    const port = await startHttpServer();
    let directionUrl;
    if (isRemoteReviewEnabled()) {
      const tunnelUrl = await openTunnel(port);
      directionUrl = buildReviewUrl(session.session_id, tunnelUrl, "direction");
    } else {
      directionUrl = `http://127.0.0.1:${port}/direction/${session.session_id}`;
    }
    try {
      const cmd2 = process.platform === "darwin" ? ["open", directionUrl] : ["xdg-open", directionUrl];
      spawn3(cmd2[0], cmd2.slice(1), { stdio: "ignore", detached: true }).unref();
    } catch (err) {
      console.error("Failed to open browser:", err);
    }
    const MAX_WAIT_DD = 30 * 60 * 1e3;
    try {
      await waitForSession(session.session_id, MAX_WAIT_DD);
    } catch {
      return {
        content: [
          {
            type: "text",
            text: JSON.stringify(
              {
                status: "timeout",
                url: directionUrl,
                session_id: session.session_id,
                message: "User did not respond within 30 minutes"
              },
              null,
              2
            )
          }
        ]
      };
    }
    const updatedDirectionSession = getSession(session.session_id);
    if (updatedDirectionSession && updatedDirectionSession.session_type === "design_direction" && updatedDirectionSession.status === "answered" && updatedDirectionSession.selection) {
      try {
        const root2 = findHaikuRoot();
        const intentFile = join20(root2, "intents", input.intent_slug, "intent.md");
        const intentRaw = await readFile4(intentFile, "utf-8");
        const intentFm = parseFrontmatter(intentRaw);
        const activeStage = intentFm.data.active_stage || "";
        if (activeStage) {
          const ssPath = stageStatePath(input.intent_slug, activeStage);
          const ssData = readJson(ssPath);
          ssData.design_direction_selected = true;
          ssData.design_direction = {
            archetype: updatedDirectionSession.selection.archetype,
            parameters: updatedDirectionSession.selection.parameters,
            ...updatedDirectionSession.selection.comments ? { comments: updatedDirectionSession.selection.comments } : {},
            ...updatedDirectionSession.selection.annotations ? { annotations: updatedDirectionSession.selection.annotations } : {}
          };
          writeJson(ssPath, ssData);
        }
      } catch {
      }
      const sel = updatedDirectionSession.selection;
      const parts = [
        `The user selected the **${sel.archetype}** direction.`
      ];
      if (sel.comments) {
        parts.push(`
Comments: ${sel.comments}`);
      }
      if (sel.annotations?.pins?.length) {
        parts.push(
          `
Visual annotations (${sel.annotations.pins.length} pins):`
        );
        for (const pin of sel.annotations.pins) {
          parts.push(
            `  - [${pin.x.toFixed(1)}%, ${pin.y.toFixed(1)}%]: ${pin.text || "(no text)"}`
          );
        }
      }
      return {
        content: [{ type: "text", text: parts.join("\n") }]
      };
    }
    return {
      content: [
        {
          type: "text",
          text: "The user did not select a design direction within the time limit. Ask them how they'd like to proceed."
        }
      ]
    };
  }
  return {
    content: [{ type: "text", text: `Unknown tool: ${name}` }],
    isError: true
  };
}
async function main() {
  const transport = new StdioServerTransport();
  await server.connect(transport);
  const harnessInfo = isClaudeCode() ? "" : ` (harness: ${getCapabilities().displayName})`;
  console.error(`H\xB7AI\xB7K\xB7U Review MCP server running on stdio${harnessInfo}`);
  startUpdateChecker();
}
