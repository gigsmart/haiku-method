  function escImgSrc(s) {
    return s.replace(/&/g, '&amp;').replace(/"/g, '%22').replace(/'/g, '%27').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  function buildAnnotationCanvasHTML(imageSrc) {
    return '<div class="relative">' +
