        type: c.type,
        sourceId: c.sourceId,
        sourceLabel: c.sourceLabel,
        text: c.text,
        quotedText: c.quotedText
      };
    });
  };

  function scrollToTarget(comment) {
    var el = comment.highlightEl;
    if (!el && comment.scrollTargetId) {
      el = document.getElementById(comment.scrollTargetId);
    }
    if (!el) return;
