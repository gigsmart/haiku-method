var require_Tunnel = __commonJS({
  "../../node_modules/localtunnel/lib/Tunnel.js"(exports2, module2) {
    var { parse: parse5 } = __require("url");
    var { EventEmitter: EventEmitter2 } = __require("events");
    var axios = require_axios2();
    var debug2 = require_src33()("localtunnel:client");
    var TunnelCluster = require_TunnelCluster();
    module2.exports = class Tunnel extends EventEmitter2 {
      constructor(opts = {}) {
        super(opts);
        this.opts = opts;
        this.closed = false;
        if (!this.opts.host) {
          this.opts.host = "https://localtunnel.me";
        }
      }
      _getInfo(body) {
        const { id, ip, port, url, cached_url, max_conn_count } = body;
        const { host, port: local_port, local_host } = this.opts;
        const { local_https, local_cert, local_key, local_ca, allow_invalid_cert } = this.opts;
        return {
          name: id,
          url,
          cached_url,
          max_conn: max_conn_count || 1,
          remote_host: parse5(host).hostname,
          remote_ip: ip,
          remote_port: port,
          local_port,
          local_host,
          local_https,
          local_cert,
          local_key,
          local_ca,
          allow_invalid_cert
        };
      }
      // initialize connection
      // callback with connection info
      _init(cb) {
        const opt = this.opts;
        const getInfo = this._getInfo.bind(this);
        const params = {
          responseType: "json"
        };
        const baseUri = `${opt.host}/`;
        const assignedDomain = opt.subdomain;
        const uri = baseUri + (assignedDomain || "?new");
        (function getUrl() {
          axios.get(uri, params).then((res) => {
            const body = res.data;
            debug2("got tunnel information", res.data);
            if (res.status !== 200) {
              const err = new Error(
                body && body.message || "localtunnel server returned an error, please try again"
              );
              return cb(err);
            }
            cb(null, getInfo(body));
          }).catch((err) => {
            debug2(`tunnel server offline: ${err.message}, retry 1s`);
            return setTimeout(getUrl, 1e3);
          });
        })();
      }
      _establish(info) {
        this.setMaxListeners(info.max_conn + (EventEmitter2.defaultMaxListeners || 10));
        this.tunnelCluster = new TunnelCluster(info);
        this.tunnelCluster.once("open", () => {
          this.emit("url", info.url);
        });
        this.tunnelCluster.on("error", (err) => {
          debug2("got socket error", err.message);
          this.emit("error", err);
        });
        let tunnelCount = 0;
        this.tunnelCluster.on("open", (tunnel) => {
          tunnelCount++;
          debug2("tunnel open [total: %d]", tunnelCount);
          const closeHandler = () => {
            tunnel.destroy();
          };
          if (this.closed) {
            return closeHandler();
          }
          this.once("close", closeHandler);
          tunnel.once("close", () => {
            this.removeListener("close", closeHandler);
          });
        });
        this.tunnelCluster.on("dead", () => {
          tunnelCount--;
          debug2("tunnel dead [total: %d]", tunnelCount);
          if (this.closed) {
            return;
          }
          this.tunnelCluster.open();
        });
        this.tunnelCluster.on("request", (req) => {
          this.emit("request", req);
        });
        for (let count = 0; count < info.max_conn; ++count) {
          this.tunnelCluster.open();
        }
      }
      open(cb) {
        this._init((err, info) => {
          if (err) {
            return cb(err);
          }
          this.clientId = info.name;
          this.url = info.url;
          if (info.cached_url) {
            this.cachedUrl = info.cached_url;
          }
          this._establish(info);
          cb();
        });
      }
      close() {
        this.closed = true;
        this.emit("close");
      }
    };
  }
});

