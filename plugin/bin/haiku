// src/tunnel.ts
import { createCipheriv, createHmac, randomBytes } from "node:crypto";
async function healthCheck() {
  if (!activeTunnel || intentionallyClosed || reconnecting) return;
  try {
    const res = await fetch(`${activeTunnel.url}/health`, {
      headers: { "bypass-tunnel-reminder": "1" },
      signal: AbortSignal.timeout(1e4)
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
  } catch {
    console.error("[haiku] Tunnel health check failed \u2014 reconnecting");
    activeTunnel?.close();
    activeTunnel = null;
    reconnectTunnel();
  }
}
function startHealthCheck() {
  stopHealthCheck();
  healthCheckTimer = setInterval(healthCheck, HEALTH_CHECK_INTERVAL);
  healthCheckTimer.unref();
}
function stopHealthCheck() {
  if (healthCheckTimer) {
    clearInterval(healthCheckTimer);
    healthCheckTimer = null;
  }
}
function base64url2(data) {
  const b64 = typeof data === "string" ? Buffer.from(data).toString("base64") : data.toString("base64");
  return b64.replace(/=/g, "").replace(/\+/g, "-").replace(/\//g, "_");
}
function signJWT(payload) {
  const header = base64url2(JSON.stringify({ alg: "HS256", typ: "JWT" }));
  const body = base64url2(JSON.stringify(payload));
  const signature = createHmac("sha256", EPHEMERAL_SECRET).update(`${header}.${body}`).digest("base64url");
  return `${header}.${body}.${signature}`;
}
async function reconnectTunnel() {
  if (reconnecting || intentionallyClosed || !tunnelPort) return;
  reconnecting = true;
  const maxRetries = 5;
  for (let attempt = 0; attempt < maxRetries; attempt++) {
    if (intentionallyClosed) break;
    const delay = attempt === 0 ? 0 : Math.min(1e3 * 2 ** (attempt - 1), 3e4);
    console.error(
      `[haiku] Tunnel reconnect attempt ${attempt + 1}/${maxRetries}${delay ? ` in ${delay}ms` : ""}`
    );
    if (delay) await new Promise((r) => setTimeout(r, delay));
    try {
      const tunnel = await (0, import_localtunnel.default)({ port: tunnelPort });
      activeTunnel = tunnel;
      attachTunnelListeners(tunnel);
      console.error(`[haiku] Tunnel reconnected: ${tunnel.url}`);
      startHealthCheck();
      reconnecting = false;
      return;
    } catch (err) {
      console.error(
        "[haiku] Tunnel reconnect failed:",
        err instanceof Error ? err.message : err
      );
    }
  }
  reconnecting = false;
  console.error(
    `[haiku] Tunnel reconnect exhausted \u2014 giving up after ${maxRetries} attempts`
  );
}
function attachTunnelListeners(tunnel) {
  tunnel.on("close", () => {
    if (activeTunnel === tunnel) {
      activeTunnel = null;
      stopHealthCheck();
      console.error("[haiku] Tunnel closed unexpectedly");
      if (!intentionallyClosed) reconnectTunnel();
    }
  });
  tunnel.on("error", (err) => {
    console.error("[haiku] Tunnel error:", err.message);
    if (activeTunnel === tunnel) {
      activeTunnel = null;
      stopHealthCheck();
      if (!intentionallyClosed) reconnectTunnel();
    }
  });
}
async function openTunnel(port) {
  if (activeTunnel) return activeTunnel.url;
  if (reconnecting) {
    await new Promise((resolve9) => {
      const check3 = setInterval(() => {
        if (!reconnecting) {
          clearInterval(check3);
          resolve9();
        }
      }, 100);
    });
    if (activeTunnel) return activeTunnel.url;
  }
  tunnelPort = port;
  intentionallyClosed = false;
  const maxRetries = 3;
  for (let attempt = 0; attempt < maxRetries; attempt++) {
    try {
      const tunnel = await (0, import_localtunnel.default)({ port });
      activeTunnel = tunnel;
      attachTunnelListeners(tunnel);
      console.error(`[haiku] Tunnel opened: ${tunnel.url}`);
      startHealthCheck();
      return tunnel.url;
    } catch (err) {
      console.error(
        `[haiku] Tunnel open failed (attempt ${attempt + 1}/${maxRetries}):`,
        err instanceof Error ? err.message : err
      );
      if (attempt < maxRetries - 1) {
        await new Promise((r) => setTimeout(r, 1e3 * (attempt + 1)));
      }
    }
  }
  throw new Error("Failed to open localtunnel after 3 attempts");
}
function closeTunnel() {
  intentionallyClosed = true;
  stopHealthCheck();
  if (activeTunnel) {
    activeTunnel.close();
    activeTunnel = null;
    console.error("[haiku] Tunnel closed");
  }
}
function isRemoteReviewEnabled() {
  return features.remoteReview;
}
function buildReviewUrl(sessionId, tunnelUrl, sessionType) {
  const key = randomBytes(32);
  e2eKeys.set(sessionId, key);
  const now = Math.floor(Date.now() / 1e3);
  const token = signJWT({
    tun: tunnelUrl,
    sid: sessionId,
    typ: sessionType,
    key: key.toString("base64url"),
    iat: now,
    exp: now + 3600
    // 1 hour TTL
  });
  return `${REVIEW_SITE_URL}/review/#${token}`;
}
function e2eEncrypt(sessionId, data) {
  const key = e2eKeys.get(sessionId);
  if (!key) return null;
  const iv = randomBytes(12);
  const cipher = createCipheriv("aes-256-gcm", key, iv);
  const input = typeof data === "string" ? Buffer.from(data, "utf-8") : data;
  const encrypted = Buffer.concat([cipher.update(input), cipher.final()]);
  const authTag = cipher.getAuthTag();
  const packed = Buffer.concat([iv, authTag, encrypted]);
  return packed.toString("base64url");
}
function isE2EActive(sessionId) {
  if (!sessionId) return e2eKeys.size > 0;
  return e2eKeys.has(sessionId);
}
function clearE2EKey(sessionId) {
  e2eKeys.delete(sessionId);
}
