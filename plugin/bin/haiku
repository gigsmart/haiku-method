// ../shared/src/frontmatter.ts
function dedupeFrontmatterKeys(raw) {
  const m2 = raw.match(/^---\r?\n([\s\S]*?)\r?\n---(\r?\n[\s\S]*)?$/);
  if (!m2) return { text: raw, removed: [] };
  const { cleaned, removed } = dedupeTopLevelYamlKeys(m2[1]);
  if (removed.length === 0) return { text: raw, removed: [] };
  return { text: `---
${cleaned}
---${m2[2] ?? ""}`, removed };
}
function dedupeTopLevelYamlKeys(yamlBlock) {
  const lines = yamlBlock.split(/\r?\n/);
  const sections = [];
  let current = null;
  for (const line of lines) {
    const m2 = line.match(/^([A-Za-z_][A-Za-z0-9_-]*)\s*:/);
    const isTopLevelKey = m2 != null && !line.startsWith(" ") && !line.startsWith("	");
    if (isTopLevelKey && m2) {
      if (current) sections.push(current);
      current = { key: m2[1], text: [line] };
    } else if (current) {
      current.text.push(line);
    } else {
      sections.push({ key: null, text: [line] });
    }
  }
  if (current) sections.push(current);
  const lastIdx = /* @__PURE__ */ new Map();
  const counts = /* @__PURE__ */ new Map();
  for (let i = 0; i < sections.length; i++) {
    const k2 = sections[i].key;
    if (!k2) continue;
    lastIdx.set(k2, i);
    counts.set(k2, (counts.get(k2) ?? 0) + 1);
  }
  const removed = [];
  for (const [k2, n] of counts) if (n > 1) removed.push(k2);
  const out5 = [];
  for (let i = 0; i < sections.length; i++) {
    const s = sections[i];
    if (s.key == null) out5.push(...s.text);
    else if (lastIdx.get(s.key) === i) out5.push(...s.text);
  }
  return { cleaned: out5.join("\n"), removed };
}
function isDuplicateKeyError(err) {
  const msg = err instanceof Error ? err.message : String(err);
  return /duplicated mapping key/i.test(msg);
}
