var require_TunnelCluster = __commonJS({
  "../../node_modules/localtunnel/lib/TunnelCluster.js"(exports2, module2) {
    var { EventEmitter: EventEmitter2 } = __require("events");
    var debug2 = require_src33()("localtunnel:client");
    var fs2 = __require("fs");
    var net3 = __require("net");
    var tls2 = __require("tls");
    var HeaderHostTransformer = require_HeaderHostTransformer();
    module2.exports = class TunnelCluster extends EventEmitter2 {
      constructor(opts = {}) {
        super(opts);
        this.opts = opts;
      }
      open() {
        const opt = this.opts;
        const remoteHostOrIp = opt.remote_ip || opt.remote_host;
        const remotePort = opt.remote_port;
        const localHost = opt.local_host || "localhost";
        const localPort = opt.local_port;
        const localProtocol = opt.local_https ? "https" : "http";
        const allowInvalidCert = opt.allow_invalid_cert;
        debug2(
          "establishing tunnel %s://%s:%s <> %s:%s",
          localProtocol,
          localHost,
          localPort,
          remoteHostOrIp,
          remotePort
        );
        const remote = net3.connect({
          host: remoteHostOrIp,
          port: remotePort
        });
        remote.setKeepAlive(true);
        remote.on("error", (err) => {
          debug2("got remote connection error", err.message);
          if (err.code === "ECONNREFUSED") {
            this.emit(
              "error",
              new Error(
                `connection refused: ${remoteHostOrIp}:${remotePort} (check your firewall settings)`
              )
            );
          }
          remote.end();
        });
        const connLocal = () => {
          if (remote.destroyed) {
            debug2("remote destroyed");
            this.emit("dead");
            return;
          }
          debug2("connecting locally to %s://%s:%d", localProtocol, localHost, localPort);
          remote.pause();
          if (allowInvalidCert) {
            debug2("allowing invalid certificates");
          }
          const getLocalCertOpts = () => allowInvalidCert ? { rejectUnauthorized: false } : {
            cert: fs2.readFileSync(opt.local_cert),
            key: fs2.readFileSync(opt.local_key),
            ca: opt.local_ca ? [fs2.readFileSync(opt.local_ca)] : void 0
          };
          const local = opt.local_https ? tls2.connect({ host: localHost, port: localPort, ...getLocalCertOpts() }) : net3.connect({ host: localHost, port: localPort });
          const remoteClose = () => {
            debug2("remote close");
            this.emit("dead");
            local.end();
          };
          remote.once("close", remoteClose);
          local.once("error", (err) => {
            debug2("local error %s", err.message);
            local.end();
            remote.removeListener("close", remoteClose);
            if (err.code !== "ECONNREFUSED") {
              return remote.end();
            }
            setTimeout(connLocal, 1e3);
          });
          local.once("connect", () => {
            debug2("connected locally");
            remote.resume();
            let stream = remote;
            if (opt.local_host) {
              debug2("transform Host header to %s", opt.local_host);
              stream = remote.pipe(new HeaderHostTransformer({ host: opt.local_host }));
            }
            stream.pipe(local).pipe(remote);
            local.once("close", (hadError) => {
