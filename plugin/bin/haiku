      return review2 === kind;
    }
  }
  return false;
}
function resolveStageMetadata(studio, stage) {
  const info = resolveStudio(studio);
  const dir = info ? info.dir : studio;
  const pluginRoot = resolvePluginRoot();
  for (const base of [
    join18(process.cwd(), ".haiku", "studios"),
