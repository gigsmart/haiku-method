// src/hooks/utils.ts
import { execSync as execSync3 } from "node:child_process";
import {
  existsSync as existsSync14,
  mkdirSync as mkdirSync7,
  readFileSync as readFileSync13,
  readdirSync as readdirSync8,
  statSync as statSync4,
  writeFileSync as writeFileSync6
} from "node:fs";
import { dirname as dirname8, join as join23 } from "node:path";
function readFrontmatterField(filePath, field) {
  if (!existsSync14(filePath)) return "";
  const content = readFileSync13(filePath, "utf8");
  const match = content.match(new RegExp(`^${field}:\\s*(.+)$`, "m"));
  return match ? match[1].trim().replace(/^["']|["']$/g, "") : "";
}
function readJson2(filePath) {
  if (!existsSync14(filePath)) return {};
  try {
    return JSON.parse(readFileSync13(filePath, "utf8"));
  } catch {
    return {};
  }
}
function findActiveIntent() {
  let repoRoot;
  try {
    repoRoot = execSync3("git rev-parse --show-toplevel", {
      encoding: "utf8"
    }).trim();
  } catch {
    repoRoot = process.cwd();
  }
  const intentsDir = join23(repoRoot, ".haiku", "intents");
  if (!existsSync14(intentsDir)) return null;
  const dirs = readdirSync8(intentsDir);
  for (const d of dirs) {
    const intentFile = join23(intentsDir, d, "intent.md");
    if (!existsSync14(intentFile)) continue;
    const status = readFrontmatterField(intentFile, "status");
    if (status === "active") {
      return join23(intentsDir, d);
    }
  }
  return null;
}
function isUnitBranch(branch) {
  if (!branch) return false;
  const parts = branch.split("/");
  return parts.length >= 3 && parts[0] === "haiku" && parts[2] !== "main";
}
function getCurrentBranch2() {
  try {
    return execSync3("git branch --show-current", { encoding: "utf8" }).trim();
  } catch {
    return "";
  }
}
function getRepoRoot() {
  try {
    return execSync3("git rev-parse --show-toplevel", {
      encoding: "utf8"
    }).trim();
  } catch {
    return process.cwd();
  }
}
function findUnitFiles(intentDir3) {
  const results = [];
  const stagesDir = join23(intentDir3, "stages");
  if (!existsSync14(stagesDir)) return results;
  for (const stage of readdirSync8(stagesDir)) {
    const unitsDir = join23(stagesDir, stage, "units");
    if (!existsSync14(unitsDir) || !statSync4(unitsDir).isDirectory()) continue;
    for (const file of readdirSync8(unitsDir)) {
      if (file.startsWith("unit-") && file.endsWith(".md")) {
        results.push(join23(unitsDir, file));
      }
    }
  }
  return results;
}
function readFrontmatterArray(filePath, field) {
  if (!existsSync14(filePath)) return [];
  const content = readFileSync13(filePath, "utf8");
  const fmMatch = content.match(/^---\n([\s\S]*?)\n---/);
  if (!fmMatch) return [];
  const frontmatter = fmMatch[1];
  const lines = frontmatter.split("\n");
  let inField = false;
  let currentItem = {};
  const items = [];
  for (const line of lines) {
    if (line.match(new RegExp(`^${field}:`))) {
      if (line.match(/\[\s*\]/)) return [];
      inField = true;
      continue;
    }
    if (inField) {
      if (!line.startsWith(" ") && !line.startsWith("	") && line.trim() !== "") {
        break;
      }
      const itemStart = line.match(/^\s+-\s+(.*)/);
      if (itemStart) {
        if (Object.keys(currentItem).length > 0) {
          items.push(currentItem);
        }
        currentItem = {};
        const kv = itemStart[1].match(/^(\w+):\s*(.+)/);
        if (kv) {
          currentItem[kv[1]] = kv[2].replace(/^["']|["']$/g, "");
        }
      } else {
        const kv = line.match(/^\s+(\w+):\s*(.+)/);
        if (kv) {
          currentItem[kv[1]] = kv[2].replace(/^["']|["']$/g, "");
        }
      }
    }
  }
  if (Object.keys(currentItem).length > 0) {
    items.push(currentItem);
  }
  return items;
}
function setFrontmatterField2(filePath, field, value) {
  if (!existsSync14(filePath)) return;
  let content = readFileSync13(filePath, "utf8");
  const regex = new RegExp(`^(${field}:)\\s*.+$`, "m");
  if (regex.test(content)) {
    content = content.replace(regex, `$1 ${value}`);
  } else {
    content = content.replace(/^---$/m, `${field}: ${value}
---`);
  }
  writeFileSync6(filePath, content);
}
function checkAllCriteria(filePath, section) {
  if (!existsSync14(filePath)) return;
  let content = readFileSync13(filePath, "utf8");
  if (!section) {
    content = content.replace(/- \[ \]/g, "- [x]");
  } else {
    const lines = content.split("\n");
    let inSection = false;
    for (let i = 0; i < lines.length; i++) {
      if (lines[i].startsWith("## ")) {
        inSection = lines[i].includes(section);
      }
      if (inSection) {
        lines[i] = lines[i].replace(/- \[ \]/g, "- [x]");
      }
    }
    content = lines.join("\n");
  }
  writeFileSync6(filePath, content);
}
function checkIntentCriteria(intentDir3) {
  const intentFile = join23(intentDir3, "intent.md");
  if (existsSync14(intentFile)) {
    const content = readFileSync13(intentFile, "utf8");
    if (content.includes("## Success Criteria")) {
      checkAllCriteria(intentFile, "Success Criteria");
    } else if (content.includes("## Completion Criteria")) {
      checkAllCriteria(intentFile, "Completion Criteria");
    }
  }
  for (const f of [
    join23(intentDir3, "completion-criteria.md"),
    join23(intentDir3, "state", "completion-criteria.md")
  ]) {
    if (existsSync14(f)) checkAllCriteria(f);
  }
}
