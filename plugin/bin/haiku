// src/model-selection.ts
function isValidModel(s) {
  return typeof s === "string" && TIER_SET.has(s);
}
function sanitizeModel(raw) {
  return isValidModel(raw) ? raw : void 0;
}
function resolveModel(inputs) {
  const candidates = [
    ["unit", inputs.unit],
    ["hat", inputs.hat],
    ["stage", inputs.stage],
    ["studio", inputs.studio]
  ];
  for (const [source, raw] of candidates) {
    const model = sanitizeModel(raw);
    if (model) return { model, source };
  }
  return { model: void 0, source: "none" };
}
function escalate(current) {
  if (!isValidModel(current)) return void 0;
  return ESCALATION[current];
}
var MODEL_TIERS, TIER_SET, ESCALATION;
