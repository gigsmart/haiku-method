function augmentCallbackHandlers(handlers2, sentryHandler) {
  if (!handlers2) {
    return [sentryHandler];
  }
  if (Array.isArray(handlers2)) {
    if (handlers2.includes(sentryHandler)) {
      return handlers2;
    }
    return [...handlers2, sentryHandler];
  }
  if (typeof handlers2 === "object") {
    return [handlers2, sentryHandler];
  }
  return handlers2;
}
