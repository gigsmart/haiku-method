// src/sessions.ts
import { EventEmitter } from "node:events";
function recordHeartbeat(sessionId) {
  if (!sessions.has(sessionId)) return false;
  lastHeartbeatAt.set(sessionId, Date.now());
  if (presenceLost.delete(sessionId)) {
    console.error(`[haiku] Presence restored for session ${sessionId}`);
  }
  return true;
}
function hasPresenceLost(sessionId) {
  return presenceLost.has(sessionId);
}
function clearHeartbeat(sessionId) {
  lastHeartbeatAt.delete(sessionId);
  presenceLost.delete(sessionId);
}
function sweepPresence() {
  const now = Date.now();
  for (const [id, ts] of lastHeartbeatAt) {
    if (now - ts <= HEARTBEAT_GRACE_MS) continue;
    const session = sessions.get(id);
    if (!session) {
      lastHeartbeatAt.delete(id);
      presenceLost.delete(id);
      continue;
    }
    if (session.session_type === "review" && session.status !== "pending" || session.session_type === "question" && session.status !== "pending" || session.session_type === "design_direction" && session.status !== "pending") {
      continue;
    }
    if (!presenceLost.has(id)) {
      presenceLost.add(id);
      console.error(
        `[haiku] Presence lost for session ${id} \u2014 no heartbeat in ${Math.round(
          (now - ts) / 1e3
        )}s`
      );
      sessionEvents.emit(`session:${id}`);
    }
  }
}
function notifySessionUpdate(sessionId) {
  sessionEvents.emit(`session:${sessionId}`);
}
function waitForSession(sessionId, timeoutMs = 30 * 60 * 1e3) {
  return new Promise((resolve9, reject) => {
    const timer2 = setTimeout(() => {
      sessionEvents.removeListener(`session:${sessionId}`, handler);
      reject(new Error("Session timeout"));
    }, timeoutMs);
    function handler() {
      clearTimeout(timer2);
      resolve9();
    }
    sessionEvents.once(`session:${sessionId}`, handler);
  });
}
function getPreviousReviewSnapshot(intentDir3) {
  return previousReviewByIntentDir.get(intentDir3);
}
function setPreviousReviewSnapshot(intentDir3, snapshot) {
  previousReviewByIntentDir.set(intentDir3, snapshot);
}
function clearPreviousReviewSnapshot(intentDir3) {
  previousReviewByIntentDir.delete(intentDir3);
}
function maybeClearOrphanedSnapshot(intentDir3) {
  if (!previousReviewByIntentDir.has(intentDir3)) return;
  for (const s of sessions.values()) {
    if (s.session_type === "review" && s.intent_dir === intentDir3) return;
  }
  previousReviewByIntentDir.delete(intentDir3);
}
function evictSessions() {
  const now = Date.now();
  for (const [id, ts] of sessionCreatedAt) {
    if (now - ts > SESSION_TTL_MS) {
      const evicted = sessions.get(id);
      sessions.delete(id);
      sessionCreatedAt.delete(id);
      clearHeartbeat(id);
      if (evicted?.session_type === "review") {
        maybeClearOrphanedSnapshot(evicted.intent_dir);
      }
    }
  }
  while (sessions.size >= MAX_SESSIONS) {
    const oldest = sessionCreatedAt.entries().next().value;
    if (!oldest) break;
    const evicted = sessions.get(oldest[0]);
    sessions.delete(oldest[0]);
    sessionCreatedAt.delete(oldest[0]);
    clearHeartbeat(oldest[0]);
    if (evicted?.session_type === "review") {
      maybeClearOrphanedSnapshot(evicted.intent_dir);
    }
  }
}
function createSession(params) {
  evictSessions();
  const session_id = crypto.randomUUID();
  const session = {
    ...params,
    session_type: "review",
    session_id,
    status: "pending",
    decision: "",
    feedback: ""
  };
  sessions.set(session_id, session);
  sessionCreatedAt.set(session_id, Date.now());
  return session;
}
function createQuestionSession(params) {
  evictSessions();
  const session_id = crypto.randomUUID();
  const session = {
    ...params,
    session_type: "question",
    session_id,
    imagePaths: params.imagePaths ?? [],
    status: "pending",
    answers: [],
    feedback: ""
  };
  sessions.set(session_id, session);
  sessionCreatedAt.set(session_id, Date.now());
  return session;
}
function createDesignDirectionSession(params) {
  evictSessions();
  const session_id = crypto.randomUUID();
  const session = {
    ...params,
    session_type: "design_direction",
    session_id,
    status: "pending",
    selection: null
  };
  sessions.set(session_id, session);
  sessionCreatedAt.set(session_id, Date.now());
  return session;
}
function getSession(sessionId) {
  return sessions.get(sessionId);
}
function updateSession2(sessionId, updates) {
  const session = sessions.get(sessionId);
  if (!session || session.session_type !== "review") return void 0;
  Object.assign(session, updates);
  if (updates.status === "decided") {
    if (session.decision === "changes_requested") {
      const intent = session.parsedIntent;
      const units = session.parsedUnits ?? [];
      const unitRawContents = {};
      for (const u3 of units) {
        if (u3?.slug && typeof u3.rawContent === "string") {
          unitRawContents[u3.slug] = u3.rawContent;
        }
      }
      setPreviousReviewSnapshot(session.intent_dir, {
        feedback: session.feedback ?? "",
        reviewedAt: (/* @__PURE__ */ new Date()).toISOString(),
        intentRawContent: intent?.rawContent ?? "",
        unitRawContents
      });
    } else {
      clearPreviousReviewSnapshot(session.intent_dir);
    }
  }
  notifySessionUpdate(sessionId);
  return session;
}
function updateQuestionSession(sessionId, updates) {
  const session = sessions.get(sessionId);
  if (!session || session.session_type !== "question") return void 0;
  Object.assign(session, updates);
  notifySessionUpdate(sessionId);
  return session;
}
function updateDesignDirectionSession(sessionId, updates) {
  const session = sessions.get(sessionId);
  if (!session || session.session_type !== "design_direction") return void 0;
  Object.assign(session, updates);
  notifySessionUpdate(sessionId);
  return session;
}
var sessionEvents, HEARTBEAT_GRACE_MS, HEARTBEAT_SWEEP_INTERVAL, lastHeartbeatAt, presenceLost, sessions, previousReviewByIntentDir, MAX_SESSIONS, SESSION_TTL_MS, sessionCreatedAt;
var init_sessions = __esm({
  "src/sessions.ts"() {
    "use strict";
    sessionEvents = new EventEmitter();
    sessionEvents.setMaxListeners(200);
    HEARTBEAT_GRACE_MS = 12e4;
    HEARTBEAT_SWEEP_INTERVAL = 5e3;
    lastHeartbeatAt = /* @__PURE__ */ new Map();
    presenceLost = /* @__PURE__ */ new Set();
    setInterval(sweepPresence, HEARTBEAT_SWEEP_INTERVAL).unref();
    sessions = /* @__PURE__ */ new Map();
    previousReviewByIntentDir = /* @__PURE__ */ new Map();
    MAX_SESSIONS = 100;
    SESSION_TTL_MS = 30 * 60 * 1e3;
    sessionCreatedAt = /* @__PURE__ */ new Map();
  }
});

