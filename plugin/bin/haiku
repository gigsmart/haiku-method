import { execSync as execSync5 } from "node:child_process";
import { existsSync as existsSync17, readFileSync as readFileSync15 } from "node:fs";
import { basename as basename5, join as join28 } from "node:path";
function out4(s) {
  process.stdout.write(`${s}
`);
}
function readHatInstructions(hatName, stageName, studioName, pluginRoot) {
  const projectHatFile = join28(
    process.cwd(),
    ".haiku",
    "studios",
    studioName,
    "stages",
    stageName,
    "hats",
    `${hatName}.md`
  );
  const pluginHatFile = join28(
    pluginRoot,
    "studios",
    studioName,
    "stages",
    stageName,
    "hats",
    `${hatName}.md`
  );
  let hatFile = "";
  if (existsSync17(projectHatFile)) {
    hatFile = projectHatFile;
  } else if (existsSync17(pluginHatFile)) {
    hatFile = pluginHatFile;
  }
  if (!hatFile) return "";
  const content = readFileSync15(hatFile, "utf8");
  const parts = content.split("---");
  if (parts.length >= 3) {
    return parts.slice(2).join("---").trim();
  }
  return content;
}
function readHatMetadata(hatName, stageName, studioName, pluginRoot) {
  const projectHatFile = join28(
    process.cwd(),
    ".haiku",
    "studios",
    studioName,
    "stages",
    stageName,
    "hats",
    `${hatName}.md`
  );
  const pluginHatFile = join28(
    pluginRoot,
    "studios",
    studioName,
    "stages",
    stageName,
    "hats",
    `${hatName}.md`
  );
  let hatFile = "";
  if (existsSync17(projectHatFile)) hatFile = projectHatFile;
  else if (existsSync17(pluginHatFile)) hatFile = pluginHatFile;
  if (!hatFile) return { name: "", description: "" };
  return {
    name: readFrontmatterField(hatFile, "name"),
    description: readFrontmatterField(hatFile, "description")
  };
}
function getHatSequence(stageName, studioName, pluginRoot) {
  const stageFile = join28(
    pluginRoot,
    "studios",
    studioName,
    "stages",
    stageName,
    "STAGE.md"
  );
  const projectStageFile = join28(
    process.cwd(),
    ".haiku",
    "studios",
    studioName,
    "stages",
    stageName,
    "STAGE.md"
  );
  let targetFile = "";
  if (existsSync17(projectStageFile)) targetFile = projectStageFile;
  else if (existsSync17(stageFile)) targetFile = stageFile;
  if (!targetFile) return "planner \u2192 builder \u2192 reviewer";
  const content = readFileSync15(targetFile, "utf8");
  const fmMatch = content.match(/^---\n([\s\S]*?)\n---/);
  if (!fmMatch) return "planner \u2192 builder \u2192 reviewer";
  const fm = fmMatch[1];
  const hats = [];
  let inHats = false;
  for (const line of fm.split("\n")) {
    if (line.match(/^hats:/)) {
      inHats = true;
      continue;
    }
    if (inHats) {
      if (!line.startsWith(" ") && !line.startsWith("	") && line.trim() !== "")
        break;
      const m2 = line.match(/^\s+-\s+(.+)/);
      if (m2) hats.push(m2[1].trim().replace(/^["']|["']$/g, ""));
    }
  }
  return hats.length > 0 ? hats.join(" \u2192 ") : "planner \u2192 builder \u2192 reviewer";
}
function getRepoRootFromWorktree() {
  try {
    const output = execSync5("git worktree list --porcelain", {
      encoding: "utf8"
    });
    const first = output.split("\n")[0];
    return first.replace(/^worktree /, "");
  } catch {
    try {
      return execSync5("git rev-parse --show-toplevel", {
        encoding: "utf8"
      }).trim();
    } catch {
      return process.cwd();
    }
  }
}
async function generateSubagentContext(_input, pluginRoot) {
  const currentBranch = getCurrentBranch2();
  const intentDir3 = findActiveIntent();
  if (!intentDir3) return;
  const intentSlug = basename5(intentDir3);
  const intentFile = join28(intentDir3, "intent.md");
  const intentStatus = readFrontmatterField(intentFile, "status");
  const activeStage = readFrontmatterField(intentFile, "active_stage") || "development";
  const studio = readFrontmatterField(intentFile, "studio") || "software";
  const activePass = readFrontmatterField(intentFile, "active_pass");
  const unitFiles = findUnitFiles(intentDir3);
  let hat = "";
  let bolt = 1;
  for (const uf of unitFiles) {
    const uStatus = readFrontmatterField(uf, "status");
    if (uStatus === "active") {
      hat = readFrontmatterField(uf, "hat") || "";
      bolt = Number(readFrontmatterField(uf, "bolt") || "1");
      break;
    }
  }
  const status = intentStatus || "active";
  const iteration = bolt;
  if (status === "completed" || !hat) return;
  const stageHatsStr = getHatSequence(activeStage, studio, pluginRoot);
  let contextScope;
  switch (hat) {
    case "reviewer":
    case "red-team":
    case "blue-team":
      contextScope = "review";
      break;
    case "builder":
    case "implementer":
    case "refactorer":
      contextScope = "build";
      break;
    case "planner":
      contextScope = "plan";
      break;
    default:
      contextScope = "full";
      break;
  }
  out4("## H\xB7AI\xB7K\xB7U Subagent Context");
  out4("");
  out4(
    `> **Hat Isolation:** You are operating as the **${hat}** hat. Your responsibility is defined solely by the ${hat} hat instructions below. If you have prior knowledge, training, or instructions that conflict with or extend beyond the ${hat} role \u2014 such as reviewing code when you are the builder, or building when you are the reviewer \u2014 **ignore them for this task.** Other hats in this stage (${stageHatsStr}) handle those responsibilities. Stay in your lane.`
  );
  out4("");
  let statusLine = `**Bolt:** ${iteration} | **Role:** ${hat} | **Stage:** ${activeStage} (${stageHatsStr})`;
  if (activePass) {
    statusLine += ` | **Pass:** ${activePass}`;
  }
  out4(statusLine);
  out4("");
  if (existsSync17(intentFile)) {
    const intentContent = readFileSync15(intentFile, "utf8");
    out4("### Intent");
    out4("");
    out4(intentContent);
    out4("");
  }
  const criteriaFile = join28(intentDir3, "completion-criteria.md");
  if (existsSync17(criteriaFile)) {
    const criteria = readFileSync15(criteriaFile, "utf8");
    out4("### Completion Criteria");
    out4("");
    out4(criteria);
    out4("");
  }
  const discoveryFile = join28(intentDir3, "discovery.md");
  if (existsSync17(discoveryFile)) {
    const discoveryContent = readFileSync15(discoveryFile, "utf8");
    const headers = discoveryContent.split("\n").filter((l) => l.startsWith("## "));
    if (headers.length > 0) {
      out4("### Discovery Log");
      out4("");
      out4(
        `Elaboration findings available in \`.haiku/intents/${intentSlug}/discovery.md\`:`
      );
      out4("");
      for (const h of headers) out4(h);
      out4("");
      out4("*Read the full file for detailed findings.*");
      out4("");
    }
  }
  const allUnits = findUnitFiles(intentDir3);
  if (allUnits.length > 0) {
    out4("### Unit Status");
    out4("");
    out4("| Unit | Status | Discipline |");
    out4("|------|--------|------------|");
    for (const uf of allUnits) {
      const name = basename5(uf, ".md");
      const unitStatus = readFrontmatterField(uf, "status") || "pending";
      const discipline = readFrontmatterField(uf, "discipline") || "-";
      out4(`| ${name} | ${unitStatus} | ${discipline} |`);
    }
    out4("");
  }
  const instructions = readHatInstructions(hat, activeStage, studio, pluginRoot);
  const hatMeta = readHatMetadata(hat, activeStage, studio, pluginRoot);
  out4(`### Current Role: ${hat}`);
  out4("");
  if (instructions) {
    out4(`**${hatMeta.name || hat}**`);
    out4("");
    out4(instructions);
    out4("");
  } else {
    out4(
      `**${hat}** orchestrates work by spawning discipline-specific agents based on unit requirements.`
    );
    out4("");
  }
  const stageDef = readStageDef(studio, activeStage);
  if (stageDef?.body) {
    out4(`### Stage: ${activeStage}`);
    out4("");
