      Object.assign(attributes, extractConfigAttributes(config5));
      if ("tools" in config5 && Array.isArray(config5.tools)) {
        const functionDeclarations = config5.tools.flatMap(
          (tool2) => tool2.functionDeclarations
        );
        attributes[GEN_AI_REQUEST_AVAILABLE_TOOLS_ATTRIBUTE] = JSON.stringify(functionDeclarations);
      }
    }
  } else {
    attributes[GEN_AI_REQUEST_MODEL_ATTRIBUTE] = extractModel({}, context2);
  }
