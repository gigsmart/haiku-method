**Call \`haiku_run_next { intent: "${slug}" }\` immediately.** Do NOT ask the user for confirmation \u2014 the gate was already approved. Do NOT present summaries or ask "want me to continue?" \u2014 just call the tool.`
      );
      break;
    }
    case "intent_complete": {
      if (isGitRepo()) {
        const mainline = getMainlineBranch();
        sections.push(
          `## Intent Complete

All stages are done for intent "${slug}". The orchestrator has marked it as completed.

### Instructions

1. Report completion summary to the user
2. Open ONE merge request from branch \`haiku/${slug}/main\` to \`${mainline}\` for final delivery
3. Include the H\xB7AI\xB7K\xB7U browse link in the description so reviewers can see the intent, units, and knowledge artifacts
4. Record the review URL via \`haiku_run_next { intent: "${slug}", external_review_url: "<url>" }\``
        );
      } else {
        sections.push(
          `## Intent Complete

All stages are done for intent "${slug}". The orchestrator has marked it as completed.

### Instructions

Report completion summary to the user.`
        );
      }
      break;
    }
    case "blocked": {
      const blockedUnits = action.blocked_units || [];
      sections.push(
        `## Blocked

Units are blocked: ${blockedUnits.join(", ")}

### Instructions

Report which units are blocked and why. Ask the user for guidance.`
      );
      break;
    }
    case "composite_run_stage": {
      const stage = action.stage;
      const compositeStudio = action.studio || studio;
      const hats = action.hats || [];
      const compositeStudioData = readStudio(compositeStudio);
      if (compositeStudioData?.body) {
        sections.push(
          `### Studio: ${compositeStudio}

${compositeStudioData.body}`
        );
      }
      const compositeStageDef = readStageDef(compositeStudio, stage);
      sections.push(`## Composite: Run ${compositeStudio}:${stage}`);
      sections.push(`Hats: ${hats.join(" -> ")}`);
      if (compositeStageDef) {
        sections.push(`### Stage Definition

${compositeStageDef.body}`);
      }
      sections.push(
        `### Instructions

The orchestrator is running a composite studio:stage. This stage belongs to the "${compositeStudio}" studio.

Call \`haiku_run_next { intent: "${slug}" }\` to get the next action.`
      );
      break;
    }
    case "outputs_missing": {
      sections.push(`## Missing Required Outputs

${action.message}`);
      break;
    }
    case "elaboration_insufficient": {
      sections.push(`## Elaboration Insufficient

${action.message}`);
      break;
    }
    case "spec_validation_failed": {
      sections.push(`## Spec Validation Failed

${action.message}`);
      break;
    }
    case "review_elaboration": {
      const stage = action.stage;
      const agents = readReviewAgentDefs(studio, stage);
      loadCrossStageAgents(studio, stage, agents);
      sections.push("## Review Elaboration Artifacts");
      sections.push(
        "Run adversarial review agents on the elaboration specs before the pre-execution gate opens."
      );
      if (Object.keys(agents).length > 0) {
        sections.push(
          "### Review Agent Fan-Out (REQUIRED)\n\n**Spawn exactly one subagent per review agent in parallel \u2014 no duplicates.** Each `<subagent>` block below is a complete prompt \u2014 relay verbatim.\n"
        );
        for (const [name, content] of Object.entries(agents)) {
          sections.push(
            `#### Subagent: \`${name}\`

<subagent tool="Task">
## Elaboration Review: ${name}

You are the "${name}" review agent reviewing elaboration artifacts for stage "${stage}" of intent "${slug}".

## Your Mandate

${content}

## Instructions

1. Read the elaboration specs: units in \`.haiku/intents/${slug}/stages/${stage}/units/\`
2. Read discovery artifacts in \`.haiku/intents/${slug}/knowledge/\`
3. Review through your mandate's lens
4. Report findings as: severity (HIGH/MEDIUM/LOW), description
5. HIGH findings MUST be fixed before execution can begin
</subagent>
`
          );
        }
      }
      sections.push(
        `### Parent Instructions (do NOT include in subagent prompts)

Spawn each subagent above using the EXACT content between \`<subagent>\` tags.
Collect findings. Fix any HIGH findings.
Then call \`haiku_run_next { intent: "${slug}" }\` to advance.`
      );
      break;
    }
    case "awaiting_external_review": {
      const externalUrl = action.external_review_url || "";
      sections.push(
        `## Awaiting External Review

${externalUrl ? `The stage is awaiting external review at: ${externalUrl}` : "The stage is awaiting external review but no review URL has been recorded."}

The orchestrator checks for approval automatically. Neither detected approval yet.

Inform the user that the stage is waiting on external review. After the review is approved, run \`/haiku:pickup\` to continue.`
      );
      break;
    }
    case "design_direction_required": {
      sections.push(
        `## Design Direction Required

This stage requires wireframe variants before proceeding.

1. Generate 2-3 distinct design approaches as HTML wireframe snippets
2. Call \`pick_design_direction\` with the variants
3. After the user selects a direction, call \`haiku_run_next { intent: "${slug}", design_direction_selected: true }\`

Check for design provider MCPs (\`mcp__pencil__*\`, \`mcp__openpencil__*\`) and use them if available.`
      );
      break;
    }
    case "discovery_missing": {
      sections.push(`## Missing Discovery Artifacts

${action.message}`);
      break;
    }
    case "dag_cycle_detected": {
      sections.push(`## Circular Dependency Detected

${action.message}`);
      break;
    }
    case "error": {
      sections.push(`## Error

${action.message}`);
      break;
    }
    case "complete": {
      sections.push(`## Already Complete

${action.message}`);
      break;
    }
    case "unit_inputs_missing": {
      sections.push(`## Missing Unit Inputs

${action.message}`);
      break;
    }
    case "fix_quality_gates": {
      sections.push(
        `## Quality Gates Failed

${action.message || "No details provided."}

### Instructions

Fix each failing gate, then call \`haiku_run_next { intent: "${slug}" }\` to retry. The orchestrator will re-run the gates before proceeding to adversarial review.`
      );
      break;
    }
    case "changes_requested": {
      const annotations = action.annotations;
      let body = `## Changes Requested

${action.message || "No details provided."}`;
      if (annotations && annotations.length > 0) {
        body += "\n\n### Annotations\n";
        for (const a of annotations) {
          body += `
- ${a.path ? `**${a.path}:** ` : ""}${a.body || ""}`;
        }
      }
      body += `

### Instructions

Address each piece of feedback, then call \`haiku_run_next { intent: "${slug}" }\` to re-submit for review.`;
      sections.push(body);
      break;
    }
    case "external_review_requested": {
      sections.push(
        `## External Review Requested

${action.message || "No details provided."}`
      );
      break;
    }
    case "unresolved_dependencies": {
      sections.push(
        `## Unresolved Dependencies

${action.message || "No details provided."}

### Instructions

Fix the \`depends_on\` fields in the affected unit files to reference existing unit names, then call \`haiku_run_next { intent: "${slug}" }\` to retry.`
      );
      break;
    }
    case "unit_naming_invalid": {
      sections.push(
        `## Unit Naming Invalid

${action.message || "No details provided."}

### Instructions

Rename the affected files to match the \`unit-NN-slug.md\` pattern (e.g., \`unit-01-data-model.md\`), then call \`haiku_run_next { intent: "${slug}" }\` to retry.`
      );
      break;
    }
    case "inputs_missing": {
      sections.push(
        `## Missing Inputs

${action.message || "Units are missing required input references."}

### Instructions

Add \`inputs:\` to each unit's frontmatter referencing the artifacts it needs, then call \`haiku_run_next { intent: "${slug}" }\` to retry.`
      );
      break;
    }
    case "gate_blocked": {
      sections.push(
        `## Gate Review Blocked

${action.message || "No details provided."}

### Instructions

Call \`haiku_run_next { intent: "${slug}" }\` to retry the gate review. If the issue persists, ask the user for guidance.`
      );
      break;
    }
    case "safe_intent_repair": {
      const synthesizedStages = action.synthesized_stages || [];
      const phaseWasRegressed = action.phase_regressed || false;
      sections.push(`## Safe Intent Repair

${action.message}`);
      if (synthesizedStages.length > 0) {
        sections.push(`**Synthesized stages:** ${synthesizedStages.join(", ")}`);
      }
      if (phaseWasRegressed) {
        sections.push(
          "**Phase regressed:** The active stage was regressed from `execute` to `elaborate` because some units are missing `inputs:` declarations. Address the missing inputs before proceeding."
        );
      }
      sections.push(
        `### Instructions

Resolve any stages needing manual review, then call \`haiku_run_next { intent: "${slug}" }\` again.`
      );
      break;
    }
    default: {
      sections.push(
        `## Unknown Action: ${action.action}

${JSON.stringify(action, null, 2)}`
      );
      break;
    }
  }
  return sections.join("\n\n");
}
function setOpenReviewHandler(handler) {
  _openReviewAndWait = handler;
}
function setElicitInputHandler(handler) {
  _elicitInput = handler;
}
async function handleOrchestratorTool(name, args2) {
  const text = (s) => ({
    content: [{ type: "text", text: s }]
  });
  const validationError = validateSlugArgs(args2);
  if (validationError) return validationError;
  if (name === "haiku_run_next") {
    const slug = args2.intent;
    const stFile = args2.state_file;
    if (args2.external_review_url) {
      try {
        const root2 = findHaikuRoot();
        const intentFile = join18(root2, "intents", slug, "intent.md");
        if (existsSync11(intentFile)) {
          const intentFm = readFrontmatter(intentFile);
          const activeStage = intentFm.active_stage || "";
          if (activeStage) {
            const ssPath = stageStatePath(slug, activeStage);
            const ssData = readJson(ssPath);
            ssData.external_review_url = args2.external_review_url;
            writeJson(ssPath, ssData);
          }
        }
      } catch {
      }
    }
    const branchCheck = validateBranch(slug, "intent");
    if (branchCheck) {
      return {
        content: [{ type: "text", text: branchCheck }],
        isError: true
      };
    }
    const result = runNext(slug);
    emitTelemetry("haiku.orchestrator.action", {
      intent: slug,
      action: result.action
    });
    if (stFile)
      logSessionEvent(stFile, {
        event: "run_next",
        intent: slug,
        action: result.action,
        stage: result.stage,
        unit: result.unit,
        hat: result.hat,
        wave: result.wave
      });
    if (stFile && result.action === "spec_validation_failed") {
      logSessionEvent(stFile, {
        event: "spec_validation_failed",
        intent: slug,
        stage: result.stage,
        violations: result.violations,
        allowed_types: result.allowed_types
      });
    }
    if (stFile && result.action === "outputs_missing") {
      logSessionEvent(stFile, {
        event: "outputs_missing",
        intent: slug,
        stage: result.stage,
        missing: result.missing
      });
    }
    if (stFile && result.action === "discovery_missing") {
      logSessionEvent(stFile, {
        event: "discovery_missing",
        intent: slug,
        stage: result.stage,
        missing: result.missing
      });
    }
    if (stFile && result.action === "review_elaboration") {
      logSessionEvent(stFile, {
        event: "review_elaboration",
        intent: slug,
        stage: result.stage
      });
    }
    let intentMeta = {};
    try {
      const iDir = intentDir2(slug);
      const intentRaw = readFileSync10(join18(iDir, "intent.md"), "utf8");
      const parsed = parseFrontmatter(intentRaw);
      intentMeta = parsed.data;
    } catch {
    }
    const intentStudio = intentMeta.studio || "";
    const withInstructions = (resultObj) => {
      enrichActionWithPreview(resultObj);
      const instructions = buildRunInstructions(
        slug,
        intentStudio,
        resultObj,
        intentDir2(slug)
      );
      const adapted = adaptInstructions(instructions);
      const { tell_user: _tu, next_step: _ns, ...resultForJson } = resultObj;
      return `${JSON.stringify(resultForJson, null, 2)}

---

${adapted}`;
    };
    if (result.action === "external_review_requested") {
      result.message = `${result.message || ""}

IMPORTANT: Ask the user WHERE they submitted the work for review (PR URL, MR link, email, Slack channel, etc.). Record the URL by calling haiku_run_next { intent: "${slug}", external_review_url: "<url>" } so the FSM can track approval status.`;
    }
    if (result.action === "gate_review" && _openReviewAndWait) {
      const stage = result.stage;
      const nextStage = result.next_stage;
      const nextPhase = result.next_phase;
      const gateContext = result.gate_context || "stage_gate";
      const gateType = result.gate_type;
      const intentDirPath = `.haiku/intents/${slug}`;
      if (stFile)
        logSessionEvent(stFile, {
          event: "gate_review_opened",
          intent: slug,
          stage,
          gate_type: gateType
        });
      try {
        const reviewResult = await _openReviewAndWait(
          intentDirPath,
          "intent",
          gateType
        );
        if (stFile)
          logSessionEvent(stFile, {
            event: "gate_decision",
            intent: slug,
            stage,
            decision: reviewResult.decision,
            feedback: reviewResult.feedback
          });
        if (reviewResult.decision === "approved") {
          if (gateContext === "intent_review") {
            const intentFilePath = join18(
              process.cwd(),
              intentDirPath,
              "intent.md"
            );
            setFrontmatterField(intentFilePath, "intent_reviewed", true);
            if (nextPhase) fsmAdvancePhase(slug, stage, nextPhase);
            gitCommitState(`haiku: intent ${slug} approved by user`);
            syncSessionMetadata(slug, args2.state_file);
            const gateResult3 = {
              action: "intent_approved",
              intent: slug,
              stage,
              from_phase: "elaborate",
              to_phase: nextPhase,
              message: `Intent approved \u2014 advancing to ${nextPhase || "execute"}. IMPORTANT: Call haiku_run_next { intent: "${slug}" } immediately. Do NOT ask the user \u2014 the transition was already approved.`
            };
            return text(withInstructions(gateResult3));
          }
          if (gateContext === "elaborate_to_execute" && nextPhase) {
            fsmAdvancePhase(slug, stage, nextPhase);
            syncSessionMetadata(slug, args2.state_file);
            const gateResult3 = {
              action: "advance_phase",
              intent: slug,
              stage,
              from_phase: "elaborate",
              to_phase: nextPhase,
              message: `Specs approved \u2014 advancing to ${nextPhase}. IMPORTANT: Call haiku_run_next { intent: "${slug}" } immediately. Do NOT ask the user \u2014 the transition was already approved.`
            };
            return text(withInstructions(gateResult3));
          }
          if (nextStage) {
            fsmAdvanceStage(slug, stage, nextStage);
            syncSessionMetadata(slug, args2.state_file);
            const gateResult3 = {
              action: "advance_stage",
              intent: slug,
              stage,
              next_stage: nextStage,
              gate_outcome: "advanced",
              message: `Approved \u2014 advancing to '${nextStage}'. IMPORTANT: Call haiku_run_next { intent: "${slug}" } immediately. Do NOT ask the user, do NOT summarize, do NOT say "want me to continue?" \u2014 the gate was already approved. Just call the tool.`
            };
            return text(withInstructions(gateResult3));
          }
          fsmCompleteStage(slug, stage, "advanced");
          fsmIntentComplete(slug);
          syncSessionMetadata(slug, args2.state_file);
          const gateResult2 = {
            action: "intent_complete",
            intent: slug,
            message: "Approved \u2014 intent complete. IMPORTANT: Report completion summary. Do NOT ask what to do next \u2014 the intent is done."
          };
          return text(withInstructions(gateResult2));
        }
        if (reviewResult.decision === "external_review") {
          fsmCompleteStage(slug, stage, "blocked");
          syncSessionMetadata(slug, args2.state_file);
          const gateResult2 = {
            action: "external_review_requested",
            intent: slug,
            stage,
            feedback: reviewResult.feedback,
            message: isGitRepo() ? `External review requested. Open ONE merge request from branch 'haiku/${slug}/${stage}' to 'haiku/${slug}/main'. Do NOT open separate MRs for individual units \u2014 all unit work is already merged into the stage branch. Include the H\xB7AI\xB7K\xB7U browse link in the description so reviewers can see the intent, units, and knowledge artifacts. Record the review URL via haiku_run_next { intent, external_review_url }. Run /haiku:pickup again after approval.` : `External review requested. Submit the work for review through your project's review process. Record the review URL via haiku_run_next { intent, external_review_url }. Run /haiku:pickup again after approval.`
          };
          return text(withInstructions(gateResult2));
        }
        if (gateContext === "intent_review") {
          syncSessionMetadata(slug, args2.state_file);
          const gateResult2 = {
            action: "changes_requested",
            intent: slug,
            stage,
            feedback: reviewResult.feedback,
            annotations: reviewResult.annotations,
            message: `Changes requested on intent: ${reviewResult.feedback || "(see annotations)"}. Revise the intent description, then call haiku_run_next { intent: "${slug}" } again.`
          };
          return text(withInstructions(gateResult2));
        }
        if (gateContext === "elaborate_to_execute") {
          syncSessionMetadata(slug, args2.state_file);
          const gateResult2 = {
            action: "changes_requested",
            intent: slug,
            stage,
            feedback: reviewResult.feedback,
            annotations: reviewResult.annotations,
            message: `Changes requested on specs: ${reviewResult.feedback || "(see annotations)"}. Fix the specs, then call haiku_run_next { intent: "${slug}" } again.`
          };
          return text(withInstructions(gateResult2));
        }
        syncSessionMetadata(slug, args2.state_file);
        const gateResult = {
          action: "changes_requested",
          intent: slug,
          stage,
          feedback: reviewResult.feedback,
          annotations: reviewResult.annotations,
          message: `Changes requested: ${reviewResult.feedback || "(see annotations)"}. Address the feedback, then call haiku_run_next { intent: "${slug}" } again.`
        };
        return text(withInstructions(gateResult));
      } catch (err) {
        const errorMsg = err instanceof Error ? err.message : String(err);
        const errorStack = err instanceof Error ? err.stack : "";
        console.error(`[haiku] gate_review failed: ${errorMsg}`);
        reportError(err, { intent: slug, stage });
        try {
          const logDir = join18(process.cwd(), ".haiku", "logs");
          mkdirSync6(logDir, { recursive: true });
          writeFileSync4(
            join18(logDir, "gate-review-error.log"),
            `${(/* @__PURE__ */ new Date()).toISOString()}
intent: ${slug}
stage: ${stage}
error: ${errorMsg}
${errorStack}
---
`,
            { flag: "a" }
          );
        } catch {
        }
        const agentFixable = errorMsg.includes("Could not parse intent") || errorMsg.includes("No such file") || errorMsg.includes("ENOENT") || errorMsg.includes("frontmatter") || errorMsg.includes("invalid identifier") || errorMsg.includes("Circular dependency") || errorMsg.includes("timeout") || errorMsg.includes("Timeout");
        if (agentFixable) {
          syncSessionMetadata(slug, args2.state_file);
          return {
            content: [
              {
                type: "text",
                text: `GATE BLOCKED: ${errorMsg}. This is a data issue the agent can fix \u2014 check that the intent directory and files are correctly structured, then call haiku_run_next again.`
              }
            ],
            isError: true
          };
        }
        if (stFile)
          logSessionEvent(stFile, {
            event: "gate_elicitation_fallback",
            intent: slug,
            stage,
            error: errorMsg
          });
        if (_elicitInput) {
          try {
            const elicitResult = await _elicitInput({
              message: gateContext === "intent_review" ? `Review UI failed (${errorMsg}). Approve intent '${slug}' to begin work?` : `Review UI failed (${errorMsg}). Approve stage '${stage}' specs to proceed to execution?`,
              requestedSchema: {
                type: "object",
                properties: {
                  decision: {
                    type: "string",
                    title: "Decision",
                    description: "Approve specs or request changes",
                    enum: ["approve", "request_changes"]
                  },
                  feedback: {
                    type: "string",
                    title: "Feedback (optional)",
                    description: "Any notes or requested changes"
                  }
                },
                required: ["decision"]
              }
            });
            if (elicitResult.action === "accept" && elicitResult.content) {
              const decision = elicitResult.content.decision;
              const feedback = elicitResult.content.feedback || "";
              if (decision === "approve") {
                if (gateContext === "intent_review") {
                  const intentFilePath = join18(
                    process.cwd(),
                    intentDirPath,
                    "intent.md"
                  );
                  setFrontmatterField(intentFilePath, "intent_reviewed", true);
                  if (nextPhase) fsmAdvancePhase(slug, stage, nextPhase);
                  gitCommitState(
                    `haiku: intent ${slug} approved by user (elicitation)`
                  );
                  syncSessionMetadata(
                    slug,
                    args2.state_file
                  );
                  const elicitApproveResult2 = {
                    action: "intent_approved",
                    intent: slug,
                    stage,
                    from_phase: "elaborate",
                    to_phase: nextPhase,
                    message: `Intent approved \u2014 advancing to ${nextPhase || "execute"}. Call haiku_run_next immediately.`
                  };
                  return text(withInstructions(elicitApproveResult2));
                }
                if (gateContext === "elaborate_to_execute" && nextPhase) {
                  fsmAdvancePhase(slug, stage, nextPhase);
                  syncSessionMetadata(
                    slug,
                    args2.state_file
                  );
                  const elicitApproveResult2 = {
                    action: "advance_phase",
                    intent: slug,
                    stage,
                    from_phase: "elaborate",
                    to_phase: nextPhase,
                    message: "Specs approved via elicitation \u2014 advancing to execute"
                  };
                  return text(withInstructions(elicitApproveResult2));
                }
                if (nextStage) {
                  fsmAdvanceStage(slug, stage, nextStage);
                  syncSessionMetadata(
                    slug,
                    args2.state_file
                  );
                  const elicitApproveResult2 = {
                    action: "advance_stage",
                    intent: slug,
                    stage,
                    next_stage: nextStage,
                    gate_outcome: "advanced",
                    message: "Approved via elicitation"
                  };
                  return text(withInstructions(elicitApproveResult2));
                }
                fsmCompleteStage(slug, stage, "advanced");
                fsmIntentComplete(slug);
                syncSessionMetadata(slug, args2.state_file);
                const elicitApproveResult = {
                  action: "intent_complete",
                  intent: slug,
                  message: "Approved via elicitation \u2014 intent complete"
                };
                return text(withInstructions(elicitApproveResult));
              }
              syncSessionMetadata(slug, args2.state_file);
              const changeMsg = gateContext === "intent_review" ? `Changes requested on intent: ${feedback}. Revise the intent description, then call haiku_run_next { intent: "${slug}" } again.` : `Changes requested: ${feedback}. Call haiku_run_next { intent: "${slug}" } again after fixing.`;
              const elicitChangesResult = {
                action: "changes_requested",
                intent: slug,
                stage,
                feedback,
                message: changeMsg
              };
              return text(withInstructions(elicitChangesResult));
            }
            syncSessionMetadata(slug, args2.state_file);
            const elicitCancelResult = {
              action: "gate_blocked",
              intent: slug,
              stage,
              message: "Gate review cancelled. Call haiku_run_next again to retry."
            };
            return text(withInstructions(elicitCancelResult));
          } catch {
          }
        }
        syncSessionMetadata(slug, args2.state_file);
        return {
          content: [
            {
              type: "text",
              text: `GATE BLOCKED: Review UI and elicitation both failed. Error: ${errorMsg}. Logged to .haiku/logs/gate-review-error.log. Call haiku_run_next to retry.`
            }
          ],
          isError: true
        };
      }
    }
    if (result.action === "safe_intent_repair") {
      try {
        const { runRepairAgent: runRepairAgent2 } = await Promise.resolve().then(() => (init_repair_agent(), repair_agent_exports));
        const root2 = findHaikuRoot();
        const iDir = join18(root2, "intents", slug);
        const studioInfo = resolveStudio(intentStudio);
        const studioDir = studioInfo?.path;
        if (!studioDir) {
          syncSessionMetadata(slug, args2.state_file);
          return text(withInstructions(result));
        }
        const activeStage = result.stage || "";
        const diagnosis = {
          slug,
          intentDir: iDir,
          studio: intentStudio,
          studioDir,
          activeStage,
          synthesizedStages: result.synthesized_stages || [],
          needsManualReview: result.needs_manual_review || [],
          phaseRegressed: result.phase_regressed || false,
          unitsMissingInputs: result.units_missing_inputs || []
        };
        const repairResult = await runRepairAgent2(diagnosis);
        if (repairResult.success && !repairResult.fallbackUsed) {
          const postRepairResult = runNext(slug);
          if (postRepairResult.action === "safe_intent_repair") {
          } else {
            emitTelemetry("haiku.orchestrator.action", {
              intent: slug,
              action: postRepairResult.action
            });
            if (stFile)
              logSessionEvent(stFile, {
                event: "run_next",
                intent: slug,
                action: postRepairResult.action,
                stage: postRepairResult.stage,
                unit: postRepairResult.unit,
                hat: postRepairResult.hat,
                wave: postRepairResult.wave
              });
            syncSessionMetadata(slug, args2.state_file);
            const repairNote = `**Intent repaired automatically:** ${repairResult.summary}

---

`;
            return {
              content: [
                {
                  type: "text",
                  text: repairNote + withInstructions(postRepairResult)
                }
              ]
            };
          }
        }
      } catch {
      }
    }
    syncSessionMetadata(slug, args2.state_file);
    return text(withInstructions(result));
  }
  if (name === "haiku_intent_create") {
    const description = args2.description;
    const titleInput = args2.title;
    let slug = args2.slug;
    if (!titleInput || typeof titleInput !== "string") {
      return text(
        JSON.stringify({
          error: "missing_title",
          message: 'haiku_intent_create requires a `title` parameter \u2014 a crisp 3\u20138 word summary (\u226480 chars, single line, no trailing period). Write it deliberately; do NOT pass a truncated description. Example: title: "Add archivable intents".'
        })
      );
    }
    if (/[\r\n]/.test(titleInput)) {
      return text(
        JSON.stringify({
          error: "invalid_title",
          message: "`title` must be a single line \u2014 got newlines. Rewrite as a crisp 3\u20138 word summary (\u226480 chars) and call again."
        })
      );
    }
    const title = titleInput.trim().replace(/\s+/g, " ");
    if (intentTitleNeedsRepair(title)) {
      return text(
        JSON.stringify({
          error: "invalid_title",
          message: `\`title\` must be non-empty and \u226480 chars after trimming. Got ${title.length} chars. Rewrite as a 3\u20138 word summary and call again.`
        })
      );
    }
    if (!slug) {
      slug = title.toLowerCase().replace(/[^a-z0-9\s-]/g, "").replace(/\s+/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "").slice(0, 50).replace(/-$/, "");
    }
    slug = validateIdentifier(slug, "intent slug");
    const stateFile = args2.state_file;
    if (stateFile) {
      const existingIntent = getSessionIntent(stateFile);
      if (existingIntent) {
        return {
          content: [
            {
              type: "text",
              text: `This session already has an active intent: '${existingIntent}'. Only one intent per session is allowed. Use /clear to start a new session, then create a new intent.`
            }
          ],
          isError: true
        };
      }
    }
    const root2 = findHaikuRoot();
    const iDir = join18(root2, "intents", slug);
    if (existsSync11(join18(iDir, "intent.md"))) {
      return text(
        JSON.stringify({
          error: "intent_exists",
          slug,
          message: `Intent '${slug}' already exists`
        })
      );
    }
    mkdirSync6(join18(iDir, "knowledge"), { recursive: true });
    mkdirSync6(join18(iDir, "stages"), { recursive: true });
    const context2 = args2.context;
    const mode = args2.mode || "continuous";
    const stagesOverride = args2.stages;
    const descriptionBody = (description || "").trim();
    const intentContent = [
      "---",
      `title: "${title.replace(/"/g, '\\"')}"`,
      `studio: ""`,
      `mode: ${mode}`,
      "status: active",
      ...stagesOverride ? [`stages:
${stagesOverride.map((s) => `  - ${s}`).join("\n")}`] : [],
      `created_at: ${timestamp()}`,
      "---",
      "",
      `# ${title}`,
      "",
      ...descriptionBody ? [descriptionBody, ""] : [],
      ...context2 ? [context2, ""] : []
    ].join("\n");
    writeFileSync4(join18(iDir, "intent.md"), intentContent);
    if (context2) {
      const knowledgeDir = join18(iDir, "knowledge");
      mkdirSync6(knowledgeDir, { recursive: true });
      writeFileSync4(
        join18(knowledgeDir, "CONVERSATION-CONTEXT.md"),
        `# Conversation Context

${context2}
`
      );
    }
    gitCommitState(`haiku: create intent ${slug}`);
    emitTelemetry("haiku.intent.created", { intent: slug });
    if (stateFile)
      logSessionEvent(stateFile, { event: "intent_created", intent: slug });
    return text(
      JSON.stringify(
        {
          action: "intent_created",
          slug,
          path: `.haiku/intents/${slug}`,
          message: `Intent '${slug}' created. Call haiku_run_next { intent: "${slug}" } to begin.`
        },
        null,
        2
      )
    );
  }
  if (name === "haiku_select_studio") {
    const slug = args2.intent;
    const root2 = findHaikuRoot();
    const iDir = join18(root2, "intents", slug);
    const intentFile = join18(iDir, "intent.md");
    if (!existsSync11(intentFile)) {
      return text(
        JSON.stringify({
          error: "not_found",
          message: `Intent '${slug}' not found`
        })
      );
    }
    const stagesDir = join18(iDir, "stages");
    if (existsSync11(stagesDir)) {
      for (const entry of readdirSync6(stagesDir, { withFileTypes: true })) {
        if (!entry.isDirectory()) continue;
        const statePath = join18(stagesDir, entry.name, "state.json");
        if (existsSync11(statePath)) {
          const state = readJson(statePath);
          if (state.status && state.status !== "pending") {
            return {
              content: [
                {
                  type: "text",
                  text: "Cannot change studio after intent has entered a stage."
                }
              ],
              isError: true
            };
          }
        }
      }
    }
    const allStudios = listStudios();
    const allStudioNames = allStudios.map((s) => s.name);
    if (allStudios.length === 0) {
      return {
        content: [{ type: "text", text: "No studios available." }],
        isError: true
      };
    }
    const options2 = args2.options || [];
    let selectedStudio = "";
    if (options2.length === 1) {
      const resolved = resolveStudio(options2[0]);
      if (!resolved) {
        return {
          content: [
            {
              type: "text",
              text: `Studio '${options2[0]}' not found. Available: ${allStudioNames.join(", ")}`
            }
          ],
          isError: true
        };
      }
      selectedStudio = resolved.dir;
    } else if (_elicitInput) {
      let elicitChoices;
      let showAllOption = false;
      const mappedOptions = options2.map((o) => resolveStudio(o)).filter((s) => s !== null).map((s) => s.name);
      if (!options2 || options2.length === 0 || mappedOptions.length >= allStudioNames.length) {
        elicitChoices = allStudioNames;
      } else if (mappedOptions.length === 0) {
        elicitChoices = allStudioNames;
      } else {
        elicitChoices = [...mappedOptions, "Show all studios..."];
        showAllOption = true;
      }
      const descriptionLines = allStudios.filter((s) => elicitChoices.includes(s.name)).map((s) => {
        const slugPart = s.slug && s.slug !== s.name ? ` (${s.slug})` : "";
        return `${s.name}${slugPart}: ${s.description || s.name}`;
      }).join("\n");
      try {
        const elicitResult = await _elicitInput({
          message: `Select a studio for intent "${slug}":

${descriptionLines}`,
          requestedSchema: {
            type: "object",
            properties: {
              studio: {
                type: "string",
                title: "Studio",
                description: "Which studio lifecycle to use",
                enum: elicitChoices
              }
            },
            required: ["studio"]
          }
        });
        if (elicitResult.action === "accept" && elicitResult.content) {
          const content = elicitResult.content;
          let chosen;
          if (content.studio === "Show all studios..." && showAllOption) {
            const allDescriptions = allStudios.map((s) => {
              const slugPart = s.slug && s.slug !== s.name ? ` (${s.slug})` : "";
              return `${s.name}${slugPart}: ${s.description || s.name}`;
            }).join("\n");
            const reElicit = await _elicitInput({
              message: `All available studios:

${allDescriptions}`,
              requestedSchema: {
                type: "object",
                properties: {
                  studio: {
                    type: "string",
                    title: "Studio",
                    enum: allStudioNames
                  }
                },
                required: ["studio"]
              }
            });
            if (reElicit.action === "accept" && reElicit.content) {
              chosen = reElicit.content.studio || "";
            } else {
              return text(
                JSON.stringify({
                  action: "cancelled",
                  message: "Studio selection cancelled by user"
                })
              );
            }
          } else {
            chosen = content.studio || "";
          }
          const resolved = resolveStudio(chosen);
          selectedStudio = resolved ? resolved.dir : "";
        } else {
          return text(
            JSON.stringify({
              action: "cancelled",
              message: "Studio selection cancelled by user"
            })
          );
        }
      } catch {
        return {
          content: [
            {
              type: "text",
              text: "Elicitation failed. Pass a single studio in the options array to auto-select."
            }
          ],
          isError: true
        };
      }
    } else {
      const studioDescriptions = allStudios.map((s) => {
        const slugPart = s.slug && s.slug !== s.name ? ` _(${s.slug})_` : "";
        return `- **${s.name}**${slugPart}: ${s.description || ""}`;
      }).join("\n");
      return text(
        JSON.stringify(
          {
            action: "select_studio_conversational",
            intent: slug,
            available_studios: allStudios.map((s) => ({
              name: s.name,
              slug: s.slug,
              aliases: s.aliases,
              description: s.description,
              category: s.category
            })),
            message: `Elicitation unavailable. Ask the user which studio to use, then call haiku_select_studio { intent: "${slug}", options: ["<chosen-studio>"] } with a single option to auto-select. The option may be the canonical name, slug, or any alias.

Available studios:
${studioDescriptions}`
          },
          null,
          2
        )
      );
    }
    if (!selectedStudio) {
      return {
        content: [{ type: "text", text: "No studio selected." }],
        isError: true
      };
    }
    const intentFmCheck = readFrontmatter(intentFile);
    const existingStages = intentFmCheck.stages;
    const allStudioStages = resolveStudioStages(selectedStudio);
    if (existingStages && existingStages.length > 0) {
      const invalid = existingStages.filter((s) => !allStudioStages.includes(s));
      if (invalid.length > 0) {
        return {
          content: [
            {
              type: "text",
              text: `Invalid stages for studio '${selectedStudio}': ${invalid.join(", ")}. Available stages: ${allStudioStages.join(", ")}`
            }
          ],
          isError: true
        };
      }
    }
    const activeStages = existingStages && existingStages.length > 0 ? existingStages : allStudioStages;
    setFrontmatterField(intentFile, "studio", selectedStudio);
    if (!existingStages || existingStages.length === 0) {
      setFrontmatterField(intentFile, "stages", activeStages);
    }
    gitCommitState(`haiku: select studio ${selectedStudio} for intent ${slug}`);
    emitTelemetry("haiku.studio.selected", {
      intent: slug,
      studio: selectedStudio
    });
    return text(
      JSON.stringify(
        {
          action: "studio_selected",
          intent: slug,
          studio: selectedStudio,
          stages: activeStages,
          all_studio_stages: allStudioStages,
          message: `Studio '${selectedStudio}' selected for intent '${slug}'. Call haiku_run_next { intent: "${slug}" } to begin.`
        },
        null,
        2
      )
    );
  }
  if (name === "haiku_revisit") {
    const result = revisit(
      args2.intent,
      args2.stage
    );
    emitTelemetry("haiku.orchestrator.action", {
      intent: args2.intent,
      action: result.action
    });
    syncSessionMetadata(
      args2.intent,
      args2.state_file
    );
    return text(JSON.stringify(result, null, 2));
  }
  if (name === "haiku_intent_reset") {
    const slug = args2.intent;
    const root2 = findHaikuRoot();
    const iDir = join18(root2, "intents", slug);
    const intentFile = join18(iDir, "intent.md");
    if (!existsSync11(intentFile)) {
      return {
        content: [
          { type: "text", text: `Intent '${slug}' not found.` }
        ],
        isError: true
      };
    }
    const raw = readFileSync10(intentFile, "utf8");
    const { data, body } = parseFrontmatter(raw);
    const title = data.title || "";
    const description = body.replace(/^#\s+.*\n+/, "").trim() || title;
    if (_elicitInput) {
      const result = await _elicitInput({
        message: `Reset intent "${slug}"?

This will DELETE all state (stages, units, knowledge) and recreate the intent with the same description.

Description: "${description}"`,
        requestedSchema: {
          type: "object",
          properties: {
            confirm: {
              type: "string",
              title: "Confirm Reset",
              description: "This cannot be undone",
              enum: ["Reset", "Cancel"]
            }
          },
          required: ["confirm"]
        }
      });
      if (result.action !== "accept" || result.content?.confirm !== "Reset") {
        return text(
          JSON.stringify({ action: "cancelled", message: "Reset cancelled." })
        );
      }
    } else {
      return {
        content: [
          {
            type: "text",
            text: "Reset requires user confirmation via elicitation."
          }
        ],
        isError: true
      };
    }
    let conversationContext = "";
    const ctxFile = join18(iDir, "knowledge", "CONVERSATION-CONTEXT.md");
    if (existsSync11(ctxFile)) {
      conversationContext = readFileSync10(ctxFile, "utf8").replace(
        /^# Conversation Context\n\n/,
        ""
      );
    }
    rmSync3(iDir, { recursive: true, force: true });
    gitCommitState(`haiku: reset intent ${slug} (deleted)`);
    return text(
      JSON.stringify(
        {
          action: "intent_reset",
          slug,
          title,
          description,
          context: conversationContext,
          message: `Intent '${slug}' has been reset. Call haiku_intent_create { title: "${title.replace(/"/g, '\\"')}", description: "${description.replace(/"/g, '\\"').replace(/\n/g, "\\n")}", slug: "${slug}"${conversationContext ? ', context: "<preserved context>"' : ""} } to recreate it.`
        },
        null,
        2
      )
    );
  }
  if (name === "haiku_intent_archive") {
    const slug = args2.intent;
    const root2 = findHaikuRoot();
    const intentFile = join18(root2, "intents", slug, "intent.md");
    if (!existsSync11(intentFile)) {
      return {
        content: [
          { type: "text", text: `Intent '${slug}' not found.` }
        ],
        isError: true
      };
    }
    const { data } = parseFrontmatter(readFileSync10(intentFile, "utf8"));
    if (data.archived === true) {
      return text(
        JSON.stringify(
          {
            action: "noop",
            slug,
            path: intentFile,
            message: `Intent '${slug}' is already archived.`
          },
          null,
          2
        )
      );
    }
    setFrontmatterField(intentFile, "archived", true);
    gitCommitState(`haiku: archive intent ${slug}`);
    return text(
      JSON.stringify(
        {
          action: "intent_archived",
          slug,
          path: intentFile,
          message: `Intent '${slug}' has been archived. Call haiku_intent_unarchive to restore it.`
        },
        null,
        2
      )
    );
  }
  if (name === "haiku_intent_unarchive") {
    const slug = args2.intent;
    const root2 = findHaikuRoot();
    const intentFile = join18(root2, "intents", slug, "intent.md");
    if (!existsSync11(intentFile)) {
      return {
        content: [
          { type: "text", text: `Intent '${slug}' not found.` }
        ],
        isError: true
      };
    }
    const raw = readFileSync10(intentFile, "utf8");
    const parsed = (0, import_gray_matter4.default)(raw);
    if (parsed.data.archived !== true) {
      return text(
        JSON.stringify(
          {
            action: "noop",
            slug,
            path: intentFile,
            message: `Intent '${slug}' is not archived.`
          },
          null,
          2
        )
      );
    }
    const { archived: _archived, ...dataWithoutArchived } = parsed.data;
    writeFileSync4(
      intentFile,
      import_gray_matter4.default.stringify(parsed.content, dataWithoutArchived)
    );
    gitCommitState(`haiku: unarchive intent ${slug}`);
    return text(
      JSON.stringify(
        {
          action: "intent_unarchived",
          slug,
          path: intentFile,
          message: `Intent '${slug}' has been unarchived.`
        },
        null,
        2
      )
    );
  }
  return text(`Unknown orchestrator tool: ${name}`);
}
